<Window x:Class="ProySistemaVentas.Views.UsuariosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuarios"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">

            <TextBox x:Name="txtBuscar"
             Width="250"
             Height="30"
             Margin="0,0,10,0"/>

            <Button Content="Buscar"
            Width="100"
            Height="30"
            Click="BtnBuscar_Click"/>

            <Button Content="Nuevo Usuario"
            Width="120"
            Height="30"
            Margin="10,0,0,0"
            Click="BtnNuevo_Click"/>

            <Button Content="Editar"
            Width="100"
            Height="30"
            Margin="10,0,0,0"
            />

            <Button Content="Activar / Desactivar"
            Width="150"
            Height="30"
            Margin="10,0,0,0"
            Click="BtnEstado_Click"/>

        </StackPanel>

        <DataGrid x:Name="dgUsuarios"
                  Grid.Row="1"
                  Margin="0,10,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="ID"
                    Binding="{Binding IdUsuario}"
                    Width="70"/>

                <DataGridTextColumn
                    Header="Nombre"
                    Binding="{Binding Nombre}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Usuario"
                    Binding="{Binding Usuario}"
                    Width="150"/>

                <DataGridTextColumn
                    Header="Rol"
                    Binding="{Binding Rol}"
                    Width="150"/>

                <DataGridCheckBoxColumn
                    Header="Activo"
                    Binding="{Binding Estado}"
                    Width="100"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>