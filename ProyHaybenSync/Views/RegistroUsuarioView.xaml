<Window x:Class="ProySistemaVentas.Views.RegistroUsuarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Usuario"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
                Text="Registrar Usuario"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,20"/>

            <TextBlock Text="Nombre"/>

            <TextBox
                x:Name="txtNombre"
                Margin="0,5,0,10"/>

            <TextBlock Text="Usuario"/>

            <TextBox
                x:Name="txtUsuario"
                Margin="0,5,0,10"/>

            <TextBlock Text="Contraseña"/>

            <PasswordBox
                x:Name="txtPassword"
                Margin="0,5,0,10"/>

            <TextBlock Text="Rol"/>

            <ComboBox
                x:Name="cmbRol"
                DisplayMemberPath="Nombre"
                SelectedValuePath="IdRol"
                Margin="0,5,0,20"/>

            <Button
                Content="Guardar Usuario"
                Click="BtnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>