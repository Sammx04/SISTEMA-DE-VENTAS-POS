<Window x:Class="ProySistemaVentas.Views.Dialogs.TransferenciaStockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transferencia de stock"
        Width="610"
        Height="665"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ================================================== -->
        <!-- COLORES -->
        <!-- ================================================== -->

        <SolidColorBrush x:Key="ColorFondo"
                         Color="#0B1120"/>

        <SolidColorBrush x:Key="ColorPanel"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="ColorPanelClaro"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="ColorPanelSecundario"
                         Color="#101B31"/>

        <SolidColorBrush x:Key="ColorBorde"
                         Color="#24344F"/>

        <SolidColorBrush x:Key="ColorTexto"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="ColorCyan"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="ColorCyanClaro"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="ColorVerde"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="ColorAmarillo"
                         Color="#F59E0B"/>

        <SolidColorBrush x:Key="ColorRojo"
                         Color="#EF4444"/>

        <!-- ================================================== -->
        <!-- TEXTBOX -->
        <!-- ================================================== -->

        <Style x:Key="TextBoxTransferencia"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="43"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="SelectionBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="BordeCampo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="BordeCampo"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter TargetName="BordeCampo"
                                        Property="Background"
                                        Value="#132039"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeCampo"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================== -->
        <!-- COMBOBOX -->
        <!-- ================================================== -->

        <Style x:Key="ComboBoxTransferencia"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="43"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <Style TargetType="ComboBoxItem">

            <Setter Property="Padding"
                    Value="12,9"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Style.Triggers>

                <Trigger Property="IsHighlighted"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1C3652"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource ColorCyanClaro}"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#164E63"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================== -->
        <!-- BOTÓN PRINCIPAL -->
        <!-- ================================================== -->

        <Style x:Key="BotonTransferir"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="MinWidth"
                    Value="155"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Foreground"
                    Value="#07111D"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="#334155"/>

                                <Setter Property="Foreground"
                                        Value="#64748B"/>

                                <Setter Property="Cursor"
                                        Value="Arrow"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================== -->
        <!-- BOTÓN SECUNDARIO -->
        <!-- ================================================== -->

        <Style x:Key="BotonCancelar"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="MinWidth"
                    Value="115"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanel}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================== -->
        <!-- BOTÓN CERRAR -->
        <!-- ================================================== -->

        <Style x:Key="BotonCerrar"
               TargetType="Button">

            <Setter Property="Width"
                    Value="36"/>

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTextoSecundario}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeCerrar"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeCerrar"
                                        Property="Background"
                                        Value="#263650"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeCerrar"
                                        Property="Opacity"
                                        Value="0.70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- ====================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ====================================================== -->

    <Border Background="{StaticResource ColorPanel}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="16">

        <Border.Effect>

            <DropShadowEffect Color="#000000"
                              BlurRadius="28"
                              ShadowDepth="5"
                              Opacity="0.55"/>

        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="70"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="78"/>

            </Grid.RowDefinitions>

            <!-- ================================================== -->
            <!-- ENCABEZADO -->
            <!-- ================================================== -->

            <Border Grid.Row="0"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">

                <Grid Margin="22,0,15,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            VerticalAlignment="Center"
                            Background="#123047"
                            BorderBrush="{StaticResource ColorCyan}"
                            BorderThickness="1"
                            CornerRadius="11">

                        <TextBlock Text="⇄"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorCyan}"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Transferencia de stock"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock Text="Movimiento desde almacén hacia tienda"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="✕"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotonCerrar}"
                            Click="BtnCerrar_Click"/>

                </Grid>

            </Border>

            <!-- ================================================== -->
            <!-- CONTENIDO -->
            <!-- ================================================== -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="25,22,25,24">

                    <!-- INFORMACIÓN DEL PRODUCTO -->

                    <Border Background="{StaticResource ColorPanelSecundario}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="48"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Top"
                                    Background="#172A44"
                                    CornerRadius="10">

                                <TextBlock Text="▣"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="19"
                                           Foreground="{StaticResource ColorCyanClaro}"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">

                                <TextBlock Text="PRODUCTO SELECCIONADO"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorCyan}"/>

                                <TextBlock x:Name="TxtProducto"
                                           Text="Nombre del producto"
                                           Margin="0,6,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTexto}"
                                           TextWrapping="Wrap"/>

                                <Grid Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Variante:"
                                               FontSize="12"
                                               Foreground="{StaticResource ColorTextoSecundario}"/>

                                    <TextBlock x:Name="TxtVariante"
                                               Grid.Column="1"
                                               Margin="7,0,0,0"
                                               Text="Única"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ColorTexto}"/>

                                </Grid>

                                <Grid Margin="0,7,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Código:"
                                               FontSize="12"
                                               Foreground="{StaticResource ColorTextoSecundario}"/>

                                    <TextBlock x:Name="TxtCodigoBarras"
                                               Grid.Column="1"
                                               Margin="7,0,0,0"
                                               Text="000000101"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ColorCyanClaro}"/>

                                </Grid>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- STOCK ACTUAL -->

                    <TextBlock Text="STOCK ACTUAL"
                               Margin="2,20,0,10"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorCyan}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- STOCK ALMACÉN -->

                        <Border Grid.Column="0"
                                Background="#11233E"
                                BorderBrush="#2563EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="ALMACÉN"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#93C5FD"/>

                                <TextBlock x:Name="TxtStockAlmacen"
                                           Text="0"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#60A5FA"/>

                                <TextBlock Text="unidades disponibles"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                        </Border>

                        <!-- STOCK TIENDA -->

                        <Border Grid.Column="2"
                                Background="#102C2A"
                                BorderBrush="{StaticResource ColorVerde}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="TIENDA"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#86EFAC"/>

                                <TextBlock x:Name="TxtStockTienda"
                                           Text="0"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorVerde}"/>

                                <TextBlock Text="unidades en venta"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- CANTIDAD -->

                    <Grid Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Cantidad a transferir"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock x:Name="TxtMaximoDisponible"
                                   Grid.Column="1"
                                   Text="Máximo disponible: 0"
                                   FontSize="11"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </Grid>

                    <TextBox x:Name="TxtCantidad"
                             Margin="0,8,0,0"
                             Style="{StaticResource TextBoxTransferencia}"
                             MaxLength="8"
                             PreviewTextInput="TxtCantidad_PreviewTextInput"
                             TextChanged="ValidarFormulario_TextChanged"/>

                    <TextBlock x:Name="TxtErrorCantidad"
                               Margin="3,6,0,0"
                               Text="Ingrese una cantidad válida."
                               FontSize="11"
                               Foreground="{StaticResource ColorRojo}"
                               Visibility="Collapsed"/>

                    <!-- RESPONSABLE -->

                    <TextBlock Text="Responsable del movimiento"
                               Margin="0,17,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <ComboBox x:Name="CboResponsable"
                              Margin="0,8,0,0"
                              Style="{StaticResource ComboBoxTransferencia}"
                              DisplayMemberPath="NombreMostrar"
                              SelectedValuePath="IdUsuario"
                              SelectionChanged="CboResponsable_SelectionChanged"/>

                    <TextBlock x:Name="TxtErrorResponsable"
                               Margin="3,6,0,0"
                               Text="Seleccione al responsable de la transferencia."
                               FontSize="11"
                               Foreground="{StaticResource ColorRojo}"
                               Visibility="Collapsed"/>

                    <!-- INFORMACIÓN -->

                    <Border Margin="0,18,0,0"
                            Padding="13"
                            Background="#10263A"
                            BorderBrush="#1D4E65"
                            BorderThickness="1"
                            CornerRadius="9">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="28"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="i"
                                       Width="20"
                                       Height="20"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       TextAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ColorCyan}"
                                       Background="#123047"/>

                            <TextBlock Grid.Column="1"
                                       Text="La cantidad será descontada del almacén y sumada a tienda. El stock total del producto no cambiará."
                                       Margin="5,0,0,0"
                                       FontSize="11"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ColorTextoSecundario}"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================== -->
            <!-- PIE -->
            <!-- ================================================== -->

            <Border Grid.Row="2"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">

                <Grid Margin="24,0">

                    <TextBlock Text="Revise los datos antes de confirmar."
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ColorTextoSecundario}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button x:Name="BtnCancelar"
                                Content="Cancelar"
                                Margin="0,0,10,0"
                                Style="{StaticResource BotonCancelar}"
                                IsCancel="True"
                                Click="BtnCerrar_Click"/>

                        <Button x:Name="BtnTransferir"
                                Content="⇄  Transferir stock"
                                Style="{StaticResource BotonTransferir}"
                                IsDefault="True"
                                IsEnabled="False"
                                Click="BtnTransferir_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>