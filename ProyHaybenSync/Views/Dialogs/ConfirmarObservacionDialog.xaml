<Window x:Class="ProySistemaVentas.Views.Dialogs.ConfirmarObservacionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        SizeToContent="Height"
        MinHeight="330"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Border Background="#0D1526"
            BorderBrush="#24344F"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <Border Background="#13203A"
                    BorderBrush="#24344F"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <TextBlock x:Name="TxtTitulo"
                           Margin="26,0"
                           VerticalAlignment="Center"
                           Foreground="#F8FAFC"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="26,24">
                <TextBlock x:Name="TxtMensaje"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,22,0,7"
                           Foreground="#94A3B8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="OBSERVACIÓN (OPCIONAL)"/>
                <TextBox x:Name="TxtObservacion"
                         MinHeight="78"
                         MaxHeight="160"
                         Padding="10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="500"
                         Background="#13203A"
                         Foreground="#F8FAFC"
                         BorderBrush="#24344F"
                         BorderThickness="1"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="#13203A"
                    BorderBrush="#24344F"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="22,0">
                    <Button Content="Cancelar"
                            Width="118"
                            Height="42"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Foreground="#F8FAFC"
                            Background="#1E293B"
                            BorderBrush="#24344F"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnConfirmar"
                            Width="142"
                            Height="42"
                            IsDefault="True"
                            Foreground="#083344"
                            Background="#22D3EE"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnConfirmar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
