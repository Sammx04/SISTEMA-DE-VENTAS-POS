<Window x:Class="ProySistemaVentas.Views.Dialogs.MensajeExitoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mensaje"
        Width="460"
        Height="270"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- COLORES -->

        <SolidColorBrush x:Key="ColorPanel"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="ColorPanelClaro"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="ColorBorde"
                         Color="#24344F"/>

        <SolidColorBrush x:Key="ColorTexto"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="ColorCyan"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="ColorCyanClaro"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="ColorVerde"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="ColorAmarillo"
                         Color="#F59E0B"/>

        <!-- BOTÓN PRINCIPAL -->

        <Style x:Key="BotonAceptar"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="MinWidth"
                    Value="120"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Foreground"
                    Value="#07111D"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN SECUNDARIO -->

        <Style x:Key="BotonCancelar"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="MinWidth"
                    Value="110"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanel}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN CERRAR -->

        <Style x:Key="BotonCerrar"
               TargetType="Button">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTextoSecundario}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeCerrar"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeCerrar"
                                        Property="Background"
                                        Value="#263650"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeCerrar"
                                        Property="Opacity"
                                        Value="0.70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- CONTENEDOR PRINCIPAL -->

    <Border Background="{StaticResource ColorPanel}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="16">

        <Border.Effect>

            <DropShadowEffect Color="#000000"
                              BlurRadius="25"
                              ShadowDepth="4"
                              Opacity="0.50"/>

        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="62"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="68"/>

            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->

            <Border Grid.Row="0"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">

                <Grid Margin="22,0,14,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtTitulo"
                               Grid.Column="0"
                               Text="Operación completada"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource BotonCerrar}"
                            VerticalAlignment="Center"
                            Click="BtnCerrar_Click"/>

                </Grid>

            </Border>

            <!-- CONTENIDO -->

            <Grid Grid.Row="1"
                  Margin="28,22,28,18">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="72"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- ÍCONO DINÁMICO -->

                <Border x:Name="BordeIcono"
                        Grid.Column="0"
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="28"
                        Background="#173C2A"
                        BorderBrush="{StaticResource ColorVerde}"
                        BorderThickness="1">

                    <TextBlock x:Name="TxtIcono"
                               Text="✓"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorVerde}"/>

                </Border>

                <!-- MENSAJE -->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="TxtSubtitulo"
                               Text="Proceso realizado correctamente"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <TextBlock x:Name="TxtMensaje"
                               Text="La operación fue realizada correctamente."
                               Margin="0,8,0,0"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource ColorTextoSecundario}"/>

                </StackPanel>

            </Grid>

            <!-- BOTONES -->

            <Border Grid.Row="2"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,22,0">

                    <Button x:Name="BtnCancelar"
                            Content="Cancelar"
                            Margin="0,0,10,0"
                            Style="{StaticResource BotonCancelar}"
                            IsCancel="True"
                            Visibility="Collapsed"
                            Click="BtnCancelar_Click"/>

                    <Button x:Name="BtnAceptar"
                            Content="Aceptar"
                            Style="{StaticResource BotonAceptar}"
                            IsDefault="True"
                            Click="BtnAceptar_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>