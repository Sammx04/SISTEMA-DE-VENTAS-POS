<Window x:Class="ProySistemaVentas.Views.Dialogs.VentaCompletadaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Venta completada"
        Width="760"
        Height="850"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- COLORES -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="ColorFondo"
                         Color="#0B1120"/>

        <SolidColorBrush x:Key="ColorPanel"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="ColorPanelClaro"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="ColorPanelSecundario"
                         Color="#101B31"/>

        <SolidColorBrush x:Key="ColorBorde"
                         Color="#24344F"/>

        <SolidColorBrush x:Key="ColorTexto"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="ColorCyan"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="ColorCyanClaro"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="ColorVerde"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="ColorRojo"
                         Color="#EF4444"/>

        <!-- ================================================= -->
        <!-- BOTÓN CERRAR -->
        <!-- ================================================= -->

        <Style x:Key="BotonCerrar"
               TargetType="Button">

            <Setter Property="Width"
                    Value="36"/>

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTextoSecundario}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="#263650"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN PRINCIPAL -->
        <!-- ================================================= -->

        <Style x:Key="BotonPrincipal"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="MinWidth"
                    Value="140"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Foreground"
                    Value="#07111D"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN SECUNDARIO -->
        <!-- ================================================= -->

        <Style x:Key="BotonSecundario"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="MinWidth"
                    Value="140"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- ===================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ===================================================== -->

    <Border Background="{StaticResource ColorPanel}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="16">

        <Border.Effect>

            <DropShadowEffect Color="#000000"
                              BlurRadius="30"
                              ShadowDepth="6"
                              Opacity="0.60"/>

        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="80"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="82"/>

            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">

                <Grid Margin="22,0,15,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            VerticalAlignment="Center"
                            Background="#10342D"
                            BorderBrush="#166534"
                            BorderThickness="1"
                            CornerRadius="24">

                        <TextBlock Text="✓"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#86EFAC"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Venta completada"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock Text="La venta fue registrada correctamente"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="#86EFAC"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="✕"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotonCerrar}"
                            Click="BtnCerrar_Click"/>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- CONTENIDO -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="25,22,25,22">

                    <!-- RESUMEN SUPERIOR -->

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="15"
                                Background="{StaticResource ColorPanelSecundario}"
                                BorderBrush="{StaticResource ColorBorde}"
                                BorderThickness="1"
                                CornerRadius="11">

                            <StackPanel>

                                <TextBlock Text="NÚMERO DE VENTA"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <TextBlock Text="{Binding NumeroVentaMostrar, Mode=OneWay}"
                                           Margin="0,7,0,0"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorCyanClaro}"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Padding="15"
                                Background="{StaticResource ColorPanelSecundario}"
                                BorderBrush="{StaticResource ColorBorde}"
                                BorderThickness="1"
                                CornerRadius="11">

                            <StackPanel>

                                <TextBlock Text="MÉTODO DE PAGO"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <TextBlock Text="{Binding MetodoPagoTexto, Mode=OneWay}"
                                           Margin="0,7,0,0"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorTexto}"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Padding="15"
                                Background="#10263A"
                                BorderBrush="#1D5369"
                                BorderThickness="1"
                                CornerRadius="11">

                            <StackPanel>

                                <TextBlock Text="TOTAL"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorCyan}"/>

                                <TextBlock Text="{Binding TotalTexto, Mode=OneWay}"
                                           Margin="0,7,0,0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorCyanClaro}"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- ================================================= -->
                    <!-- BOLETA IMPRIMIBLE -->
                    <!-- ================================================= -->

                    <Border x:Name="BoletaImprimible"
                            Width="440"
                            HorizontalAlignment="Center"
                            Padding="25"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="4">

                        <StackPanel>

                            <!-- EMPRESA -->

                            <TextBlock Text="SCAYA MOTOS"
                                       HorizontalAlignment="Center"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>

                            <TextBlock Text="VENTA DE PRODUCTOS Y ACCESORIOS"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBlock Text="BOLETA DE VENTA"
                                       Margin="0,13,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>

                            <Border Margin="0,15,0,15"
                                    Height="1"
                                    Background="#D1D5DB"/>

                            <!-- DATOS DE LA VENTA -->

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="130"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Nro. venta:"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding NumeroVentaMostrar, Mode=OneWay}"
                                           FontSize="10"
                                           TextAlignment="Right"
                                           Foreground="#111827"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,5,0,0"
                                           Text="Fecha:"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,5,0,0"
                                           Text="{Binding FechaVentaTexto, Mode=OneWay}"
                                           FontSize="10"
                                           TextAlignment="Right"
                                           Foreground="#111827"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Margin="0,5,0,0"
                                           Text="Trabajador:"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,5,0,0"
                                           Text="{Binding NombreTrabajadorMostrar, Mode=OneWay}"
                                           FontSize="10"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           Foreground="#111827"/>

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Margin="0,5,0,0"
                                           Text="Cliente:"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="0,5,0,0"
                                           Text="{Binding NombreClienteMostrar, Mode=OneWay}"
                                           FontSize="10"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           Foreground="#111827"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Margin="0,5,0,0"
                                           Text="Documento:"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Margin="0,5,0,0"
                                           Text="{Binding DocumentoClienteTexto, Mode=OneWay}"
                                           FontSize="10"
                                           TextAlignment="Right"
                                           Foreground="#111827"/>

                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Margin="0,5,0,0"
                                           Text="Método:"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Margin="0,5,0,0"
                                           Text="{Binding MetodoPagoTexto, Mode=OneWay}"
                                           FontSize="10"
                                           TextAlignment="Right"
                                           Foreground="#111827"/>

                            </Grid>

                            <Border Margin="0,15,0,12"
                                    Height="1"
                                    Background="#D1D5DB"/>

                            <!-- ENCABEZADO DEL DETALLE -->

                            <Grid Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="55"/>

                                    <ColumnDefinition Width="80"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="PRODUCTO"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Column="1"
                                           Text="CANT."
                                           FontSize="9"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           Foreground="#374151"/>

                                <TextBlock Grid.Column="2"
                                           Text="TOTAL"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           TextAlignment="Right"
                                           Foreground="#374151"/>

                            </Grid>

                            <!-- PRODUCTOS -->

                            <ItemsControl ItemsSource="{Binding Detalle, Mode=OneWay}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Padding="0,9"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,1,0,0">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="55"/>

                                                    <ColumnDefinition Width="80"/>

                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,8,0">

                                                    <TextBlock Text="{Binding NombreProducto, Mode=OneWay}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="#111827"/>

                                                    <TextBlock Text="{Binding DetalleProducto, Mode=OneWay}"
                                                               Margin="0,3,0,0"
                                                               FontSize="8"
                                                               TextWrapping="Wrap"
                                                               Foreground="#6B7280"/>

                                                    <TextBlock Margin="0,3,0,0"
                                                               FontSize="8"
                                                               Foreground="#6B7280">

                                                        <Run Text="{Binding PrecioUnitarioTexto, Mode=OneWay}"/>

                                                        <Run Text=" por unidad"/>

                                                    </TextBlock>

                                                    <TextBlock Margin="0,3,0,0"
                                                               FontSize="8"
                                                               Foreground="#B45309">

                                                        <Run Text="Descuento: "/>

                                                        <Run Text="{Binding DescuentoTexto, Mode=OneWay}"/>

                                                    </TextBlock>

                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Cantidad, Mode=OneWay}"
                                                           VerticalAlignment="Top"
                                                           FontSize="10"
                                                           TextAlignment="Center"
                                                           Foreground="#111827"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TotalLineaTexto, Mode=OneWay}"
                                                           VerticalAlignment="Top"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           TextAlignment="Right"
                                                           Foreground="#111827"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- TOTALES -->

                            <Border Margin="0,14,0,12"
                                    Height="1"
                                    Background="#9CA3AF"/>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <!-- SUBTOTAL -->

                                <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="Subtotal:"
               FontSize="10"
               Foreground="#374151"/>

                                <TextBlock Grid.Row="0"
               Grid.Column="1"
               Text="{Binding SubtotalTexto, Mode=OneWay}"
               FontSize="10"
               TextAlignment="Right"
               Foreground="#111827"/>

                                <!-- DESCUENTO -->

                                <Grid x:Name="FilaDescuento"
          Grid.Row="1"
          Grid.ColumnSpan="2"
          Margin="0,6,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                   Text="Descuentos:"
                   FontSize="10"
                   Foreground="#374151"/>

                                    <TextBlock Grid.Column="1"
                   Text="{Binding DescuentoTotalTexto, Mode=OneWay}"
                   FontSize="10"
                   TextAlignment="Right"
                   Foreground="#B45309"/>

                                </Grid>

                                <!-- RECARGO TARJETA -->

                                <Grid x:Name="FilaRecargoTarjeta"
          Grid.Row="2"
          Grid.ColumnSpan="2"
          Margin="0,6,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                   Text="Recargo tarjeta (5%):"
                   FontSize="10"
                   Foreground="#374151"/>

                                    <TextBlock Grid.Column="1"
                   Text="{Binding IGVTexto, Mode=OneWay}"
                   FontSize="10"
                   TextAlignment="Right"
                   Foreground="#B45309"/>

                                </Grid>

                                <!-- TOTAL -->

                                <TextBlock Grid.Row="3"
               Grid.Column="0"
               Margin="0,11,0,0"
               Text="TOTAL:"
               FontSize="13"
               FontWeight="Bold"
               Foreground="#111827"/>

                                <TextBlock Grid.Row="3"
               Grid.Column="1"
               Margin="0,11,0,0"
               Text="{Binding TotalTexto, Mode=OneWay}"
               FontSize="16"
               FontWeight="Bold"
               TextAlignment="Right"
               Foreground="#111827"/>

                            </Grid>

                            <Border Margin="0,18,0,12"
                                    Height="1"
                                    Background="#D1D5DB"/>

                            <TextBlock Text="Gracias por su compra"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                            <TextBlock Text="Conserve este comprobante"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="9"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">

                <Grid Margin="22,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Puede imprimir o compartir la información de la venta."
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource ColorTextoSecundario}"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="BtnWhatsApp"
                                Content="▣  WhatsApp"
                                Margin="0,0,9,0"
                                Style="{StaticResource BotonSecundario}"
                                Click="BtnWhatsApp_Click"/>

                        <Button x:Name="BtnImprimir"
                                Content="🖨  Imprimir boleta"
                                Margin="0,0,9,0"
                                Style="{StaticResource BotonSecundario}"
                                Click="BtnImprimir_Click"/>

                        <Button x:Name="BtnNuevaVenta"
                                Content="＋  Nueva venta"
                                Style="{StaticResource BotonPrincipal}"
                                IsDefault="True"
                                Click="BtnNuevaVenta_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>