<Window x:Class="ProySistemaVentas.Views.Dialogs.NuevaCategoriaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva categoría"
        Width="470"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- COLORES -->

        <SolidColorBrush x:Key="ColorFondo"
                         Color="#0B1120"/>

        <SolidColorBrush x:Key="ColorPanel"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="ColorPanelClaro"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="ColorCyan"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="ColorCyanClaro"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="ColorTexto"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="ColorBorde"
                         Color="#24344F"/>

        <!-- TEXTBOX -->

        <Style x:Key="TextBoxDialog"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="BordeTextBox"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="BordeTextBox"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN PRINCIPAL -->

        <Style x:Key="BotonPrincipal"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Foreground"
                    Value="#07111D"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN SECUNDARIO -->

        <Style x:Key="BotonSecundario"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- CONTENEDOR PRINCIPAL -->

    <Border Background="{StaticResource ColorPanel}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="16">

        <Border.Effect>

            <DropShadowEffect Color="#000000"
                              BlurRadius="25"
                              ShadowDepth="4"
                              Opacity="0.45"/>

        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="65"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->

            <Border Grid.Row="0"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">

                <Grid Margin="22,0,15,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="#1A2A47"
                            VerticalAlignment="Center">

                        <TextBlock Text="+"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorCyan}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="13,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Nueva categoría"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock Text="Registre una categoría para los productos"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="34"
                            Height="34"
                            Content="✕"
                            Padding="0"
                            FontSize="13"
                            Background="Transparent"
                            Foreground="{StaticResource ColorTextoSecundario}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrar_Click"/>

                </Grid>

            </Border>

            <!-- CONTENIDO -->

            <Grid Grid.Row="1"
                  Margin="25,21,25,23">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Nombre de la categoría"
                           FontSize="13"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="TxtNombreCategoria"
                         Grid.Row="1"
                         Style="{StaticResource TextBoxDialog}"
                         MaxLength="100"
                         KeyDown="TxtNombreCategoria_KeyDown"/>

                <TextBlock x:Name="TxtMensajeError"
                           Grid.Row="2"
                           Margin="2,7,0,0"
                           Text="Ingrese un nombre para la categoría."
                           FontSize="11"
                           Foreground="#EF4444"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancelar"
                            MinWidth="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource BotonSecundario}"
                            Click="BtnCancelar_Click"/>

                    <Button Content="Guardar categoría"
                            MinWidth="145"
                            Style="{StaticResource BotonPrincipal}"
                            Click="BtnGuardar_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>