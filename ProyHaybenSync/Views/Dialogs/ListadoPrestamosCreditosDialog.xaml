<Window x:Class="ProySistemaVentas.Views.Dialogs.ListadoPrestamosCreditosDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado"
        Width="1180"
        Height="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B1120"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0D1526"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#13203A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#24344F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="#67E8F9"/>
            <Setter Property="Background" Value="#101B31"/>
            <Setter Property="BorderBrush" Value="#2B3E60"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,0,34,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#101B31"/>
            <Setter Property="BorderBrush" Value="#2B3E60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Path Data="M0,0 L5,5 L10,0 Z" Fill="#67E8F9" Width="10" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240" Margin="0,4,0,0" Padding="4" Background="#0D1526" BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#22D3EE"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#22D3EE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Margin="1" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#164E63"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#0E7490"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InputDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#101B31"/><Setter Property="BorderBrush" Value="#2B3E60"/><Setter Property="BorderThickness" Value="1"/>
            <Style.Resources><Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#101B31"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></Style.Resources>
        </Style>
        <Style TargetType="Calendar"><Setter Property="Background" Value="#101B31"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#2B3E60"/></Style>
        <Style TargetType="CalendarDayButton"><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#164E63"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0E7490"/></Trigger></Style.Triggers></Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="Background" Value="#13203A"/><Setter Property="Foreground" Value="#67E8F9"/><Setter Property="BorderBrush" Value="#24344F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#22D3EE"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IconActionStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3,0"/></Style>
        <Style x:Key="LoanActionStyle" TargetType="Button" BasedOn="{StaticResource IconActionStyle}"><Style.Triggers><DataTrigger Binding="{Binding EsCredito}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="CreditActionStyle" TargetType="Button" BasedOn="{StaticResource IconActionStyle}"><Style.Triggers><DataTrigger Binding="{Binding EsPrestamo}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ReceiptActionStyle" TargetType="Button" BasedOn="{StaticResource CreditActionStyle}"><Style.Triggers><DataTrigger Binding="{Binding IdPagoCredito}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1526"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#24344F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeight" Value="64"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#24344F"/><Setter Property="RowBackground" Value="#0D1526"/><Setter Property="AlternatingRowBackground" Value="#101B31"/><Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#13203A"/><Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="BorderBrush" Value="#24344F"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="10,5"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#172A46"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#164E63"/></Trigger></Style.Triggers></Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="2,0,2,0"><TextBlock x:Name="TxtTitulo" Foreground="#F8FAFC" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="TxtSubtitulo" Margin="0,35,0,0" Foreground="#94A3B8" FontSize="13"/></Grid>
        <Border Grid.Row="1" Margin="0,18,0,14" Padding="12" Background="#0D1526" BorderBrush="#24344F" BorderThickness="1" CornerRadius="10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtTexto" Style="{StaticResource InputStyle}" Margin="0,0,8,0" TextChanged="FiltroCambiado"/>
                <ComboBox x:Name="CboEstado" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,8,0" SelectionChanged="FiltroCambiado"><ComboBoxItem Content="Todos los estados" Tag="" IsSelected="True"/><ComboBoxItem Content="Pendiente" Tag="PENDIENTE"/><ComboBoxItem Content="Completado" Tag="COMPLETADO"/></ComboBox>
                <DatePicker x:Name="DpInicio" Grid.Column="2" Style="{StaticResource InputDatePickerStyle}" Margin="0,0,8,0" SelectedDateChanged="FiltroCambiado"/>
                <DatePicker x:Name="DpFin" Grid.Column="3" Style="{StaticResource InputDatePickerStyle}" Margin="0,0,8,0" SelectedDateChanged="FiltroCambiado"/>
                <Button Grid.Column="4" Style="{StaticResource ButtonStyle}" Content="Limpiar" Click="BtnLimpiar_Click"/>
                <Button Grid.Column="5" Style="{StaticResource ButtonStyle}" Content="Exportar Excel" Click="BtnExportarExcel_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <DataGrid x:Name="DgOperaciones" ItemsSource="{Binding}" HorizontalContentAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nro." Binding="{Binding NumeroOperacion}" Width="100"/>
                    <DataGridTextColumn Header="Cliente / tienda" Binding="{Binding ClienteTienda}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="Producto" Width="2.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="6,4" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><Run Text="{Binding NombreProducto}"/><Run Text=" - " Foreground="#94A3B8"/><Run Text="{Binding Variante}"/></TextBlock><TextBlock Grid.Row="1" Foreground="#94A3B8" FontSize="9" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><Run Text="Código: "/><Run Text="{Binding CodigoBarra}"/><Run Text=" · "/><Run Text="{Binding NumeroOperacion}"/></TextBlock></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Cant." Binding="{Binding CantidadTexto}" Width="62"/>
                    <DataGridTextColumn Header="Total / deuda" Binding="{Binding TotalTexto}" Width="95"/>
                    <DataGridTemplateColumn Header="Fecha / vencimiento" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><TextBlock Text="{Binding FechaRegistroTexto}" Foreground="#CBD5E1" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding EsCredito}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding FechaPagoEsperadaTexto}" Foreground="#FCD34D" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EsCredito}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Estado" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="8" Padding="8,4" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#123524"/><Style.Triggers><DataTrigger Binding="{Binding EstaPendiente}" Value="True"><Setter Property="Background" Value="#3A2A10"/></DataTrigger><DataTrigger Binding="{Binding VenceHoy}" Value="True"><Setter Property="Background" Value="#164E63"/></DataTrigger><DataTrigger Binding="{Binding EstaVencido}" Value="True"><Setter Property="Background" Value="#3A1D22"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EstadoMostrar}" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#86EFAC"/><Style.Triggers><DataTrigger Binding="{Binding EstaPendiente}" Value="True"><Setter Property="Foreground" Value="#FCD34D"/></DataTrigger><DataTrigger Binding="{Binding VenceHoy}" Value="True"><Setter Property="Foreground" Value="#67E8F9"/></DataTrigger><DataTrigger Binding="{Binding EstaVencido}" Value="True"><Setter Property="Foreground" Value="#F87171"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Acciones" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconActionStyle}" Background="#334155" Foreground="#E2E8F0" ToolTip="Ver detalle" Tag="{Binding}" Click="BtnVer_Click"><Viewbox Width="15" Height="15"><Path Data="M1,8 C3,4.3 5.5,2.5 8,2.5 C10.5,2.5 13,4.3 15,8 C13,11.7 10.5,13.5 8,13.5 C5.5,13.5 3,11.7 1,8 Z M8,5.5 A2.5,2.5 0 1 1 8,10.5 A2.5,2.5 0 1 1 8,5.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox></Button>
                        <Button Style="{StaticResource LoanActionStyle}" Background="#22C55E" Foreground="#052E16" ToolTip="Devolver al stock" Tag="{Binding}" IsEnabled="{Binding PuedeDevolver}" Click="BtnDevolver_Click"><TextBlock Text="↩" FontSize="17" FontWeight="Bold"/></Button>
                        <Button Style="{StaticResource LoanActionStyle}" Background="#F59E0B" Foreground="#451A03" ToolTip="Convertir a cobranza" Tag="{Binding}" IsEnabled="{Binding PuedePasarACobranza}" Click="BtnCobranza_Click"><TextBlock Text="$" FontSize="16" FontWeight="Bold"/></Button>
                        <Button Style="{StaticResource CreditActionStyle}" Background="#22C55E" Foreground="#052E16" ToolTip="Registrar pago" Tag="{Binding}" IsEnabled="{Binding PuedePagar}" Click="BtnPagar_Click"><TextBlock Text="$" FontSize="16" FontWeight="Bold"/></Button>
                        <Button Style="{StaticResource CreditActionStyle}" Background="#3B82F6" Foreground="#FFFFFF" ToolTip="Convertir a préstamo" Tag="{Binding}" IsEnabled="{Binding PuedePasarAPrestamo}" Click="BtnPrestamo_Click"><TextBlock Text="↔" FontSize="16" FontWeight="Bold"/></Button>
                        <Button Style="{StaticResource ReceiptActionStyle}" Background="#0E7490" Foreground="#FFFFFF" ToolTip="Ver boleta" Tag="{Binding}" Click="BtnBoleta_Click"><TextBlock Text="▤" FontSize="15"/></Button>
                    </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="No se encontraron registros" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=DgOperaciones}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TxtPagina" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button x:Name="BtnAnterior" Grid.Column="1" Style="{StaticResource ButtonStyle}" Content="Anterior" Click="BtnAnterior_Click"/><Button x:Name="BtnSiguiente" Grid.Column="2" Style="{StaticResource ButtonStyle}" Content="Siguiente" Click="BtnSiguiente_Click"/></Grid>
    </Grid>
</Window>
