<Window x:Class="ProySistemaVentas.Views.Dialogs.EditarItemVentaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar producto de la venta"
        Width="560"
        Height="690"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- COLORES -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="ColorFondo"
                         Color="#0B1120"/>

        <SolidColorBrush x:Key="ColorPanel"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="ColorPanelClaro"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="ColorPanelSecundario"
                         Color="#101B31"/>

        <SolidColorBrush x:Key="ColorBorde"
                         Color="#24344F"/>

        <SolidColorBrush x:Key="ColorTexto"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="ColorCyan"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="ColorCyanClaro"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="ColorVerde"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="ColorAmarillo"
                         Color="#F59E0B"/>

        <SolidColorBrush x:Key="ColorRojo"
                         Color="#EF4444"/>

        <!-- ================================================= -->
        <!-- TEXTBOX -->
        <!-- ================================================= -->

        <Style x:Key="TextBoxVenta"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="SelectionBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="BordeCampo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="BordeCampo"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter TargetName="BordeCampo"
                                        Property="Background"
                                        Value="#132039"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeCampo"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN PRINCIPAL -->
        <!-- ================================================= -->

        <Style x:Key="BotonGuardar"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="MinWidth"
                    Value="145"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Foreground"
                    Value="#07111D"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="#334155"/>

                                <Setter Property="Foreground"
                                        Value="#64748B"/>

                                <Setter Property="Cursor"
                                        Value="Arrow"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN SECUNDARIO -->
        <!-- ================================================= -->

        <Style x:Key="BotonCancelar"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="MinWidth"
                    Value="110"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanel}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN CERRAR -->
        <!-- ================================================= -->

        <Style x:Key="BotonCerrar"
               TargetType="Button">

            <Setter Property="Width"
                    Value="36"/>

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTextoSecundario}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeCerrar"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeCerrar"
                                        Property="Background"
                                        Value="#263650"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTONES PRECIO -->
        <!-- ================================================= -->

        <Style x:Key="BotonTipoPrecio"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeTipoPrecio"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeTipoPrecio"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- ===================================================== -->
    <!-- CONTENEDOR -->
    <!-- ===================================================== -->

    <Border Background="{StaticResource ColorPanel}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="16">

        <Border.Effect>

            <DropShadowEffect Color="#000000"
                              BlurRadius="28"
                              ShadowDepth="5"
                              Opacity="0.55"/>

        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="70"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="78"/>

            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">

                <Grid Margin="22,0,15,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            VerticalAlignment="Center"
                            Background="#123047"
                            BorderBrush="{StaticResource ColorCyan}"
                            BorderThickness="1"
                            CornerRadius="11">

                        <TextBlock Text="✎"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorCyan}"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Editar producto del carrito"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock Text="Los cambios se aplicarán solamente a esta venta"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="✕"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotonCerrar}"
                            Click="BtnCerrar_Click"/>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- CONTENIDO -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="25,22,25,22">

                    <!-- PRODUCTO -->

                    <Border Padding="17"
                            Background="{StaticResource ColorPanelSecundario}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="48"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Top"
                                    Background="#172A44"
                                    CornerRadius="10">

                                <TextBlock Text="▣"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="19"
                                           Foreground="{StaticResource ColorCyan}"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,10,0">

                                <TextBlock x:Name="TxtNombreProducto"
                                           Text="Nombre del producto"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorTexto}"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="TxtDetalleProducto"
                                           Text="Categoría - Variante"
                                           Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <TextBlock x:Name="TxtCodigoBarra"
                                           Text="Código: 000000101"
                                           Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorCyanClaro}"/>

                            </StackPanel>

                            <Border Grid.Column="2"
                                    Padding="9,5"
                                    VerticalAlignment="Top"
                                    Background="#102C2A"
                                    BorderBrush="#166534"
                                    BorderThickness="1"
                                    CornerRadius="13">

                                <TextBlock x:Name="TxtStockDisponible"
                                           Text="Stock: 0"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#86EFAC"/>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- TIPO DE PRECIO -->

                    <TextBlock Text="Tipo de precio"
                               Margin="0,19,0,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnPrecioUnidad"
                                Grid.Column="0"
                                Style="{StaticResource BotonTipoPrecio}"
                                Click="BtnPrecioUnidad_Click">

                            <StackPanel>

                                <TextBlock Text="Precio por unidad"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="TxtPrecioUnidadOriginal"
                                           Text="S/ 0.00"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                        </Button>

                        <Button x:Name="BtnPrecioMayor"
                                Grid.Column="2"
                                Style="{StaticResource BotonTipoPrecio}"
                                Click="BtnPrecioMayor_Click">

                            <StackPanel>

                                <TextBlock Text="Precio por mayor"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="TxtPrecioMayorOriginal"
                                           Text="S/ 0.00"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                    <!-- PRECIO APLICADO -->

                    <Grid Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Precio aplicado a esta venta"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Puede modificarse manualmente"
                                   FontSize="10"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </Grid>

                    <TextBox x:Name="TxtPrecio"
                             Margin="0,8,0,0"
                             Style="{StaticResource TextBoxVenta}"
                             MaxLength="12"
                             PreviewTextInput="TxtDecimal_PreviewTextInput"
                             TextChanged="CamposCalculo_TextChanged"/>

                    <TextBlock x:Name="TxtErrorPrecio"
                               Margin="3,6,0,0"
                               Text="Ingrese un precio válido."
                               FontSize="11"
                               Foreground="{StaticResource ColorRojo}"
                               Visibility="Collapsed"/>

                    <!-- CANTIDAD -->

                    <Grid Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Cantidad"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock x:Name="TxtCantidadMaxima"
                                   Grid.Column="1"
                                   Text="Máximo: 0"
                                   FontSize="10"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </Grid>

                    <TextBox x:Name="TxtCantidad"
                             Margin="0,8,0,0"
                             Style="{StaticResource TextBoxVenta}"
                             MaxLength="8"
                             PreviewTextInput="TxtEntero_PreviewTextInput"
                             TextChanged="CamposCalculo_TextChanged"/>

                    <TextBlock x:Name="TxtErrorCantidad"
                               Margin="3,6,0,0"
                               Text="Ingrese una cantidad válida."
                               FontSize="11"
                               Foreground="{StaticResource ColorRojo}"
                               Visibility="Collapsed"/>

                    <!-- DESCUENTO -->

                    <Grid Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Descuento"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Opcional"
                                   FontSize="10"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </Grid>

                    <TextBox x:Name="TxtDescuento"
                             Margin="0,8,0,0"
                             Style="{StaticResource TextBoxVenta}"
                             MaxLength="12"
                             PreviewTextInput="TxtDecimal_PreviewTextInput"
                             TextChanged="CamposCalculo_TextChanged"/>

                    <TextBlock x:Name="TxtErrorDescuento"
                               Margin="3,6,0,0"
                               Text="El descuento no puede superar el importe."
                               FontSize="11"
                               Foreground="{StaticResource ColorRojo}"
                               Visibility="Collapsed"/>

                    <!-- TOTAL -->

                    <Border Margin="0,19,0,0"
                            Padding="16"
                            Background="#10263A"
                            BorderBrush="#1D5369"
                            BorderThickness="1"
                            CornerRadius="11">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="TOTAL DEL PRODUCTO"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorCyan}"/>

                                <TextBlock x:Name="TxtResumenCalculo"
                                           Text="S/ 0.00 × 0 - S/ 0.00"
                                           Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                            <TextBlock x:Name="TxtTotalLinea"
                                       Grid.Column="1"
                                       Text="S/ 0.00"
                                       VerticalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ColorCyanClaro}"/>

                        </Grid>

                    </Border>

                    <!-- AVISO -->

                    <Border Margin="0,15,0,0"
                            Padding="12"
                            Background="#302810"
                            BorderBrush="#765910"
                            BorderThickness="1"
                            CornerRadius="9">

                        <TextBlock Text="Este precio y descuento se guardarán únicamente en el detalle de esta venta. El precio general del producto no será modificado."
                                   FontSize="10"
                                   LineHeight="16"
                                   TextWrapping="Wrap"
                                   Foreground="#FDE68A"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- PIE -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="{StaticResource ColorPanelClaro}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">

                <Grid Margin="24,0">

                    <TextBlock Text="Revise el precio, cantidad y descuento."
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ColorTextoSecundario}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button x:Name="BtnCancelar"
                                Content="Cancelar"
                                Margin="0,0,10,0"
                                Style="{StaticResource BotonCancelar}"
                                IsCancel="True"
                                Click="BtnCerrar_Click"/>

                        <Button x:Name="BtnGuardarCambios"
                                Content="✓  Aplicar cambios"
                                Style="{StaticResource BotonGuardar}"
                                IsDefault="True"
                                Click="BtnGuardarCambios_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>