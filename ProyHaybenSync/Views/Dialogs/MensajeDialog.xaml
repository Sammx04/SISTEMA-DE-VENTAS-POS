<Window x:Class="ProySistemaVentas.Views.Dialogs.MensajeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="#0D1526"
            BorderBrush="#24344F"
            BorderThickness="1"
            CornerRadius="18">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="86"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->

            <Border Grid.Row="0"
                    Background="#13203A"
                    CornerRadius="18,18,0,0"
                    BorderBrush="#24344F"
                    BorderThickness="0,0,0,1">

                <Grid Margin="26,0,18,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtTitulo"
                               VerticalAlignment="Center"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Button Grid.Column="1"
                            Width="38"
                            Height="38"
                            Content="×"
                            FontSize="24"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrar_Click"/>

                </Grid>

            </Border>

            <!-- MENSAJE -->

            <Grid Grid.Row="1"
                  Margin="34,34,34,34">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="BordeIcono"
                        Width="66"
                        Height="66"
                        CornerRadius="33"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderThickness="1.5">

                    <TextBlock x:Name="TxtIcono"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="35"
                               FontWeight="Bold"/>

                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="TxtEncabezado"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="TxtMensaje"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               Foreground="#A7B3C9"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

            <!-- BOTONES -->

            <Border Grid.Row="2"
                    Background="#13203A"
                    CornerRadius="0,0,18,18"
                    BorderBrush="#24344F"
                    BorderThickness="0,1,0,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="22,0">

                    <Button x:Name="BtnNo"
                            Width="125"
                            Height="48"
                            Margin="0,0,12,0"
                            Content="No"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#24344F"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="BtnNo_Click"/>

                    <Button x:Name="BtnSi"
                            Width="125"
                            Height="48"
                            Content="Aceptar"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#07111F"
                            Background="#22D3EE"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnSi_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>