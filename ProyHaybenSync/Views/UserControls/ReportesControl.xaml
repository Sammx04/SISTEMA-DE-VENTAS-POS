<UserControl x:Class="ProySistemaVentas.Views.UserControls.ReportesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <UserControl.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="TextTitle" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSubtitle" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentCyanBright" Color="#67E8F9"/>
        <SolidColorBrush x:Key="AccentCyanDark" Color="#164E63"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="PanelBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#334155"/>

        <DropShadowEffect x:Key="SombraTarjeta"
                          BlurRadius="14"
                          ShadowDepth="0"
                          Opacity="0.35"/>

        <!-- Tarjeta de indicador -->
        <Style x:Key="TarjetaIndicador" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <!-- Botón contorno cian -->
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentCyanDark}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón sólido cian -->
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonAccion}">
            <Setter Property="Background" Value="{StaticResource AccentCyan}"/>
            <Setter Property="Foreground" Value="#06202A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentCyanBright}"/>
                    <Setter Property="Foreground" Value="#06202A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Etiqueta de filtro -->
        <Style x:Key="LabelFiltro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSubtitle}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Cuadro de filtro -->
        <Style x:Key="TextBoxFiltro" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ComboBoxFiltro" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1C3652"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBright}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#1A2538"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="DarkDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border BorderThickness="0" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1C3652"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Scrollbars -->
        <Style x:Key="ScrollBarOscuro" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 1. ENCABEZADO ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Reportes"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextTitle}"/>
            <TextBlock Text="Consulta, exporta e imprime los reportes de ventas e inventario."
                       FontSize="13"
                       Foreground="{StaticResource TextSubtitle}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- ============ 2. FILTROS ============ -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBg}"
                CornerRadius="10"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,14">
            <StackPanel>
                <!-- Tipo de reporte + acciones -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Reporte" Style="{StaticResource LabelFiltro}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbTipoReporte"
                                  Style="{StaticResource ComboBoxFiltro}"
                                  Width="270"
                                  SelectionChanged="cmbTipoReporte_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnExportarCsv"
                                Content="Exportar CSV"
                                Style="{StaticResource BotonAccion}"
                                Click="btnExportarCsv_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="btnImprimir"
                                Content="Imprimir"
                                Style="{StaticResource BotonAccion}"
                                Click="btnImprimir_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="btnGenerar"
                                Content="Generar"
                                Style="{StaticResource BotonPrimario}"
                                Click="btnGenerar_Click"
                                Width="120"/>
                    </StackPanel>
                </Grid>

                <!-- Filtros -->
                <WrapPanel>
                    <!-- Periodo (reportes de ventas) -->
                    <StackPanel x:Name="pnlDesde" Margin="0,0,14,10">
                        <TextBlock Text="DESDE" Style="{StaticResource LabelFiltro}"/>
                        <TextBox x:Name="txtDesde" Style="{StaticResource TextBoxFiltro}" Width="120" LostFocus="txtDesde_LostFocus"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlHasta" Margin="0,0,14,10">
                        <TextBlock Text="HASTA" Style="{StaticResource LabelFiltro}"/>
                        <TextBox x:Name="txtHasta" Style="{StaticResource TextBoxFiltro}" Width="120" LostFocus="txtHasta_LostFocus"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlUsuario" Margin="0,0,14,10">
                        <TextBlock Text="USUARIO" Style="{StaticResource LabelFiltro}"/>
                        <ComboBox x:Name="cmbUsuario" Style="{StaticResource ComboBoxFiltro}" Width="190" DisplayMemberPath="NombreMostrar"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlMetodoPago" Margin="0,0,14,10">
                        <TextBlock Text="METODO DE PAGO" Style="{StaticResource LabelFiltro}"/>
                        <ComboBox x:Name="cmbMetodoPago" Style="{StaticResource ComboBoxFiltro}" Width="160"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlCategoria" Margin="0,0,14,10">
                        <TextBlock Text="CATEGORIA" Style="{StaticResource LabelFiltro}"/>
                        <ComboBox x:Name="cmbCategoria" Style="{StaticResource ComboBoxFiltro}" Width="180" DisplayMemberPath="Nombre"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlTopN" Margin="0,0,14,10" Visibility="Collapsed">
                        <TextBlock Text="CANTIDAD" Style="{StaticResource LabelFiltro}"/>
                        <ComboBox x:Name="cmbTopN" Style="{StaticResource ComboBoxFiltro}" Width="110" SelectedIndex="2"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlUbicacion" Margin="0,0,14,10" Visibility="Collapsed">
                        <TextBlock Text="UBICACION" Style="{StaticResource LabelFiltro}"/>
                        <ComboBox x:Name="cmbUbicacion" Style="{StaticResource ComboBoxFiltro}" Width="150"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlEstadoStock" Margin="0,0,14,10" Visibility="Collapsed">
                        <TextBlock Text="ESTADO DE STOCK" Style="{StaticResource LabelFiltro}"/>
                        <ComboBox x:Name="cmbEstadoStock" Style="{StaticResource ComboBoxFiltro}" Width="150"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlBuscar" Margin="0,0,14,10">
                        <TextBlock Text="BUSCAR" Style="{StaticResource LabelFiltro}"/>
                        <TextBox x:Name="txtBuscar" Style="{StaticResource TextBoxFiltro}" Width="180" KeyDown="txtBuscar_KeyDown"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Aviso de Kardex sin datos -->
                <TextBlock x:Name="txtAvisoKardex"
                           Visibility="Collapsed"
                           Foreground="{StaticResource WarningAmber}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="La tabla dbo.MovimientoStock todavia no es alimentada por los procedimientos del sistema, por lo que este reporte devuelve cero filas hasta que se instrumente el registro de movimientos."/>
            </StackPanel>
        </Border>

        <!-- ============ 3. INDICADORES ============ -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <Border Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock x:Name="lblIndicador1" Text="REGISTROS" FontSize="10" Foreground="{StaticResource TextSubtitle}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtIndicador1" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextTitle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock x:Name="lblIndicador2" Text="SUBTOTAL" FontSize="10" Foreground="{StaticResource TextSubtitle}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtIndicador2" Text="0.00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextTitle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock x:Name="lblIndicador3" Text="TOTAL" FontSize="10" Foreground="{StaticResource TextSubtitle}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtIndicador3" Text="0.00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock x:Name="lblIndicador4" Text="UNIDADES" FontSize="10" Foreground="{StaticResource TextSubtitle}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtIndicador4" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextTitle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="tarjetaIndicador5" Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock x:Name="lblIndicador5" Text="TICKET PROMEDIO" FontSize="10" Foreground="{StaticResource TextSubtitle}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtIndicador5" Text="0.00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextTitle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- ============ 4. RESULTADOS ============ -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBg}"
                CornerRadius="10"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1">
            <Grid>
                <DataGrid x:Name="dgReporte"
                          Style="{StaticResource DarkDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          MouseDoubleClick="dgReporte_MouseDoubleClick"/>

                <TextBlock x:Name="txtSinDatos"
                           Text="Selecciona un reporte y pulsa Generar."
                           Foreground="{StaticResource TextSubtitle}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ============ 5. PIE ============ -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="txtResumenPago"
                       Foreground="{StaticResource TextSubtitle}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="txtConteoFilas"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource TextSubtitle}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
