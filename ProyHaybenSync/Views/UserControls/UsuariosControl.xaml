<UserControl x:Class="ProySistemaVentas.Views.UserControls.UsuariosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <UserControl.Resources>
        <!-- Colores Globales -->
        <SolidColorBrush x:Key="TextTitle" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSubtitle" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentCyanDark" Color="#164E63"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="GridHeaderBg" Color="#0F172A"/>

        <!-- ESTILO DE BOTONES (Cian con borde) -->
        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentCyanDark}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO BOTÓN NUEVO USUARIO (Sólido) -->
        <Style x:Key="BtnNuevoUsuario" TargetType="Button" BasedOn="{StaticResource BtnAccion}">
            <Setter Property="Background" Value="{StaticResource AccentCyan}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#67E8F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO DATAGRID OSCURO -->
        <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#1A2538"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="55"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <!-- ESTILO ENCABEZADOS -->
        <Style x:Key="DarkDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Estilo para celdas -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border BorderThickness="0" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DE FILAS -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Gestión de Usuarios" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextTitle}"/>
                <TextBlock Text="Administra los usuarios registrados en el sistema." FontSize="13" Foreground="{StaticResource TextSubtitle}" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 2. BARRA DE HERRAMIENTAS -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1E293B" CornerRadius="6" Height="35" Padding="10,0" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Left" Width="350">
                <Grid>
                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="{StaticResource TextSubtitle}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBuscar" 
                             TextChanged="txtBuscar_TextChanged"
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="White" 
                             FontSize="13" 
                             VerticalAlignment="Center" 
                             Margin="25,0,0,0" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <Button Content="Buscar" Style="{StaticResource BtnAccion}" Click="BtnBuscar_Click" Margin="0,0,8,0"/>
                <Button Content="+ Nuevo Usuario" Style="{StaticResource BtnNuevoUsuario}" Click="BtnNuevo_Click" Margin="0,0,8,0"/>
                <Button Content="✎ Editar" Style="{StaticResource BtnAccion}" Click="BtnEditar_Click" Margin="0,0,8,0"/>
                <Button Content="⏻ Activar / Desactivar" Style="{StaticResource BtnAccion}" Click="BtnEstado_Click" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 3. DATAGRID -->
        <DataGrid x:Name="dgUsuarios"
                  Grid.Row="2"
                  Style="{StaticResource DarkDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdUsuario}" Width="60"/>
                <DataGridTemplateColumn Header="USUARIO" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding Usuario}" FontSize="12" Foreground="{StaticResource TextSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ROL" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding Rol}" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ESTADO" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="True">
                                                <Setter Property="Background" Value="#064E3B"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="False">
                                                <Setter Property="Background" Value="#7F1D1D"/>
                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessGreen}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource DangerRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="True">
                                                        <Setter Property="Text" Value="Activo"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="False">
                                                        <Setter Property="Text" Value="Inactivo"/>
                                                        <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. PAGINACIÓN (FUNCIONAL) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <TextBlock x:Name="txtEstadoPagina" Text="Mostrando 1 a 6 de 18 usuarios" 
                       Foreground="{StaticResource TextSubtitle}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <StackPanel Orientation="Horizontal">
                <!-- Botón Anterior -->
                <Border x:Name="btnAnterior" Width="30" Height="30" CornerRadius="4" 
                        Background="Transparent" BorderBrush="#334155" BorderThickness="1" Margin="2"
                        MouseLeftButtonDown="IrPaginaAnterior" Cursor="Hand">
                    <TextBlock Text="&lt;" Foreground="{StaticResource TextSubtitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Contenedor de páginas (se rellena en código) -->
                <StackPanel x:Name="pnlPageNumbers" Orientation="Horizontal"/>

                <!-- Botón Siguiente -->
                <Border x:Name="btnSiguiente" Width="30" Height="30" CornerRadius="4" 
                        Background="Transparent" BorderBrush="#334155" BorderThickness="1" Margin="2"
                        MouseLeftButtonDown="IrPaginaSiguiente" Cursor="Hand">
                    <TextBlock Text="&gt;" Foreground="{StaticResource TextSubtitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>