<UserControl x:Class="ProySistemaVentas.Views.UserControls.AlmacenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ProySistemaVentas.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="#0B1120"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ================= PALETA ================= -->

        <SolidColorBrush x:Key="ColorFondo"
                         Color="#0B1120"/>

        <SolidColorBrush x:Key="ColorPanel"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="ColorPanelClaro"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="ColorSeleccion"
                         Color="#1A2A47"/>

        <SolidColorBrush x:Key="ColorCyan"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="ColorCyanClaro"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="ColorTexto"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="ColorTextoClaro"
                         Color="#CBD5E1"/>

        <SolidColorBrush x:Key="ColorBorde"
                         Color="#24344F"/>

        <SolidColorBrush x:Key="ColorVerde"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="ColorAmarillo"
                         Color="#F59E0B"/>

        <SolidColorBrush x:Key="ColorRojo"
                         Color="#EF4444"/>

        <LinearGradientBrush x:Key="CyanGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">

            <GradientStop Color="#22D3EE"
                          Offset="0"/>

            <GradientStop Color="#2563EB"
                          Offset="1"/>

        </LinearGradientBrush>

        <!-- ================= TEXTBOX ================= -->

        <Style x:Key="TextBoxModern"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Border"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter TargetName="Border"
                                        Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect Color="#22D3EE"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.20"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================= COMBOBOX ================= -->

        <Style x:Key="ComboBoxModern"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>

        <!-- ================= BOTÓN PRINCIPAL ================= -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Foreground"
                    Value="#07111D"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================= BOTÓN SECUNDARIO ================= -->

        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTextoClaro}"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource ColorSeleccion}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================= TARJETAS ================= -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource ColorPanel}"/>

            <Setter Property="CornerRadius"
                    Value="15"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect Color="#000000"
                                      BlurRadius="18"
                                      ShadowDepth="2"
                                      Opacity="0.20"/>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================= DATAGRID ================= -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTextoClaro}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="RowBackground"
                    Value="{StaticResource ColorPanel}"/>

            <Setter Property="AlternatingRowBackground"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="RowHeight"
                    Value="43"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTextoSecundario}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource ColorSeleccion}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource ColorCyanClaro}"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource ColorFondo}">

        <Grid.RowDefinitions>

            <RowDefinition Height="72"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================= ENCABEZADO ================= -->

        <Border Grid.Row="0"
                Background="{StaticResource ColorPanel}"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Almacén / Productos"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <TextBlock Text="Gestión y creación de productos con código de barras"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ColorTextoSecundario}"/>

                </StackPanel>

                <Border Grid.Column="1"
                        Width="44"
                        Height="44"
                        CornerRadius="12"
                        Background="{StaticResource CyanGradient}">

                    <TextBlock Text="▣"
                               FontSize="21"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Border>

        <!-- ================= CONTENIDO ================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="24">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- ================= PARTE SUPERIOR ================= -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>

                    <!-- FORMULARIO -->

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,20">

                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="9"
                                        Background="{StaticResource ColorSeleccion}">

                                    <TextBlock Text="▤"
                                               Foreground="{StaticResource ColorCyan}"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Margin="12,0,0,0">

                                    <TextBlock Text="Formulario de registro"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ColorTexto}"/>

                                    <TextBlock Text="Complete los datos del producto"
                                               Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ColorTextoSecundario}"/>

                                </StackPanel>

                            </StackPanel>

                            <TextBlock Text="Nombre del producto"
                                       Foreground="{StaticResource ColorTextoClaro}"
                                       Margin="0,0,0,6"/>

                            <TextBox x:Name="TxtNombreProducto"
                                     Style="{StaticResource TextBoxModern}"/>

                            <TextBlock Text="Categoría"
                                       Foreground="{StaticResource ColorTextoClaro}"
                                       Margin="0,16,0,6"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="10"/>

                                    <ColumnDefinition Width="45"/>

                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="CboCategoria"
                                          Grid.Column="0"
                                          Style="{StaticResource ComboBoxModern}"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="IdCategoria"
                                          SelectedIndex="0"
                                          IsEditable="False"/>

                                <Button Grid.Column="2"
                                        Content="+"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="0"
                                        ToolTip="Crear Nueva Categoria"
                                        Click="BtnNuevaCategoria_Click"/>

                            </Grid>

                            <TextBlock Text="Descripción"
                                       Foreground="{StaticResource ColorTextoClaro}"
                                       Margin="0,16,0,6"/>

                            <TextBox x:Name="TxtDescripcion"
                                     Height="78"
                                     Padding="12,9"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Style="{StaticResource TextBoxModern}"/>

                            <Grid Margin="0,20,0,12">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Variantes / Presentaciones"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                <Button Grid.Column="1"
                                        Content="+ Agregar variante"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnAgregarVariante_Click"/>

                            </Grid>

                            <DataGrid x:Name="DgVariantes"
          Height="205"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          SelectionMode="Single"
          HeadersVisibility="Column"
          RowHeight="48"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <!-- DESCRIPCIÓN -->

                                    <!-- DESCRIPCIÓN -->

                                    <DataGridTemplateColumn Header="Descripción"
                        Width="180"
                        MinWidth="160">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding Descripcion,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     Margin="4"
                     MinWidth="145"
                     Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>
                                    <!-- CÓDIGO DE BARRAS -->

                                    <DataGridTemplateColumn Header="Código"
                                Width="190">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Grid Margin="4">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="6"/>

                                                        <ColumnDefinition Width="45"/>

                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0">

                                                        <TextBox x:Name="TxtCodigoVariante"
                                     Text="{Binding CodigoBarras,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxModern}"/>

                                                        <!-- TEXTO MOSTRADO CUANDO NO HAY CÓDIGO -->

                                                        <TextBlock Text="Se genera automáticamente"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ColorTextoSecundario}"
                                       FontSize="11"
                                       IsHitTestVisible="False">

                                                            <TextBlock.Style>

                                                                <Style TargetType="TextBlock">

                                                                    <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding CodigoBarras}"
                                                         Value="">

                                                                            <Setter Property="Visibility"
                                                        Value="Visible"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding CodigoBarras}"
                                                         Value="{x:Null}">

                                                                            <Setter Property="Visibility"
                                                        Value="Visible"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>

                                                                </Style>

                                                            </TextBlock.Style>

                                                        </TextBlock>

                                                    </Grid>

                                                    <Button Grid.Column="2"
                                Content="Gen"
                                Height="34"
                                Padding="0"
                                Tag="{Binding}"
                                ToolTip="Generar código de barras"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnGenerarCodigoVariante_Click"/>

                                                </Grid>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <!-- PRECIO UNITARIO -->

                                    <DataGridTemplateColumn Header="Precio U."
                                Width="100">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding PrecioUnidad,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Margin="4"
                             HorizontalContentAlignment="Center"
                             Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <!-- PRECIO MAYOR -->

                                    <DataGridTemplateColumn Header="Precio M."
                                Width="100">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding PrecioMayor,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Margin="4"
                             HorizontalContentAlignment="Center"
                             Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <!-- STOCK -->

                                    <!-- STOCK PARA PRODUCTO NUEVO -->

                                    <DataGridTemplateColumn x:Name="ColStockInicial"
                        Header="Stock"
                        Width="90">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding Stock,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     Margin="4"
                     HorizontalContentAlignment="Center"
                     Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <!-- STOCK ACTUAL: SOLO CUANDO SE EDITA -->

                                    <!-- STOCK ACTUAL: SOLO CUANDO SE EDITA -->

                                    <DataGridTemplateColumn x:Name="ColStockActual"
                        Header="Stock actual"
                        Width="100"
                        Visibility="Collapsed">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding StockActual, Mode=OneWay}"
                     Height="34"
                     Margin="4"
                     IsReadOnly="True"
                     IsTabStop="False"
                     HorizontalContentAlignment="Center"
                     Foreground="{StaticResource ColorTextoSecundario}"
                     Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>
                                    <!-- INGRESO -->

                                    <DataGridTemplateColumn x:Name="ColIngreso"
                        Header="+ Ingreso"
                        Width="90"
                        Visibility="Collapsed">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding Ingreso,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     Margin="4"
                     HorizontalContentAlignment="Center"
                     Foreground="{StaticResource ColorVerde}"
                     Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <!-- SALIDA -->

                                    <DataGridTemplateColumn x:Name="ColSalida"
                        Header="- Salida"
                        Width="90"
                        Visibility="Collapsed">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding Salida,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     Margin="4"
                     HorizontalContentAlignment="Center"
                     Foreground="{StaticResource ColorRojo}"
                     Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <!-- NUEVO STOCK -->

                                    <DataGridTemplateColumn x:Name="ColNuevoStock"
                        Header="Nuevo"
                        Width="90"
                        Visibility="Collapsed">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBox Text="{Binding NuevoStock, Mode=OneWay}"
         Height="34"
         Margin="4"
         IsReadOnly="True"
         IsTabStop="False"
         HorizontalContentAlignment="Center"
         Foreground="{StaticResource ColorCyanClaro}"
         Style="{StaticResource TextBoxModern}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>
                                    <!-- ACCIÓN -->

                                    <DataGridTemplateColumn Header="Acción"
                                Width="75">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Button Content="🗑"
                            Width="38"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Center"
                            Tag="{Binding}"
                            ToolTip="Eliminar variante"
                            Foreground="{StaticResource ColorRojo}"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnEliminarVariante_Click"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,22,0,0">

                                <Button x:Name="BtnGuardarProducto"
                                        Content="Guardar producto"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnGuardarProducto_Click"/>

                                <Button x:Name="BtnCancelarEdicion"
                                        Content="Cancelar"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Visibility="Collapsed"
                                        Click="BtnCancelarEdicion_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- PANEL DERECHO -->

                    <StackPanel Grid.Column="2">

                        <!-- CÓDIGO DE BARRAS -->

                        <Border Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="Identificación y código"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                <TextBlock Text="Seleccionar variante"
                                           Margin="0,18,0,6"
                                           Foreground="{StaticResource ColorTextoClaro}"/>

                                <!-- SELECTOR DE VARIANTE -->

                                <Grid Margin="0,18,0,0">

                                    <ComboBox x:Name="CboVarianteCodigo"
              Style="{StaticResource ComboBoxModern}"
              DisplayMemberPath="Descripcion"
              SelectionChanged="CboVarianteCodigo_SelectionChanged"/>

                                    <!-- TEXTO MOSTRADO CUANDO NO HAY UNA VARIANTE SELECCIONADA -->

                                    <TextBlock x:Name="TxtSeleccioneVarianteCodigo"
               Text="Seleccione una variante"
               Margin="13,0,40,0"
               VerticalAlignment="Center"
               Foreground="{StaticResource ColorTextoSecundario}"
               FontSize="12"
               IsHitTestVisible="False"/>

                                </Grid>

                                <!-- CONTENEDOR DEL CÓDIGO -->

                                <Grid Margin="0,18,0,16">

                                    <!-- ESTADO VACÍO -->

                                    <Border x:Name="PanelCodigoVacio"
            Height="165"
            CornerRadius="12"
            Background="{StaticResource ColorPanelClaro}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1">

                                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                                            <TextBlock Text="▥"
                       FontSize="30"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource ColorTextoSecundario}"
                       Opacity="0.35"/>

                                            <TextBlock Text="Genere o seleccione un código de barras"
                       Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{StaticResource ColorTextoSecundario}"/>

                                        </StackPanel>

                                    </Border>

                                    <!-- ESTADO CON CÓDIGO GENERADO -->

                                    <Border x:Name="PanelCodigoGenerado"
            Height="165"
            CornerRadius="12"
            Background="{StaticResource ColorPanelClaro}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            Visibility="Collapsed">

                                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                                            <!-- REPRESENTACIÓN VISUAL TEMPORAL -->

                                            <TextBlock Text="|||| || ||||| ||| ||||"
                       FontFamily="Consolas"
                       FontSize="28"
                       Foreground="{StaticResource ColorTexto}"
                       HorizontalAlignment="Center"/>

                                            <TextBlock x:Name="TxtNumeroCodigo"
                       Margin="0,5,0,0"
                       FontFamily="Consolas"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ColorTexto}"
                       HorizontalAlignment="Center"/>

                                            <TextBlock x:Name="TxtProductoCodigo"
                       Margin="0,10,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ColorTexto}"
                       HorizontalAlignment="Center"/>

                                            <TextBlock x:Name="TxtVarianteCodigo"
                       Margin="0,3,0,0"
                       FontSize="11"
                       Foreground="{StaticResource ColorTextoClaro}"
                       HorizontalAlignment="Center"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>

                                <Button x:Name="BtnImprimirEtiqueta"
        Content="Imprimir etiquetas"
        Style="{StaticResource PrimaryButton}"
        IsEnabled="False"
        Click="BtnImprimirEtiquetas_Click"/>

                                <TextBlock Text="Formato: CODE128"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                        </Border>
                    </StackPanel>

                </Grid>

                <!-- ================= LISTADO ================= -->

                <Border Grid.Row="1"
        Margin="0,20,0,20"
        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <!-- ENCABEZADO -->

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="250"/>

                                <ColumnDefinition Width="12"/>

                                <ColumnDefinition Width="190"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Lista de productos"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}"/>

                                <TextBlock x:Name="TxtTotalProductos"
                           Text="0 productos"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                            <!-- BUSCADOR -->

                            <TextBox x:Name="TxtBuscarProducto"
                     Grid.Column="1"
                     Style="{StaticResource TextBoxModern}"
                     ToolTip="Buscar producto o código de barras"
                     TextChanged="TxtBuscarProducto_TextChanged"/>

                            <!-- FILTRO DE CATEGORÍA -->

                            <ComboBox x:Name="CboFiltroCategoria"
                      Grid.Column="3"
                      Style="{StaticResource ComboBoxModern}"
                      DisplayMemberPath="Nombre"
                      SelectedValuePath="IdCategoria"
                      SelectionChanged="CboFiltroCategoria_SelectionChanged"/>

                        </Grid>

                        <!-- INFORMACIÓN Y PAGINACIÓN -->

                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtRangoProductos"
                       Grid.Column="0"
                       Text="No hay productos para mostrar"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource ColorTextoSecundario}"/>

                            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                                <Button x:Name="BtnAnteriorPagina"
                        Content="Anterior"
                        Width="80"
                        Height="34"
                        Padding="0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnAnteriorPagina_Click"/>

                                <StackPanel x:Name="PanelPaginas"
                            Orientation="Horizontal"
                            Margin="5,0"/>

                                <Button x:Name="BtnSiguientePagina"
                        Content="Siguiente"
                        Width="82"
                        Height="34"
                        Padding="0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnSiguientePagina_Click"/>

                            </StackPanel>

                        </Grid>

                        <!-- TABLA -->

                        <DataGrid x:Name="DgProductos"
                  MinHeight="350"
                  RowHeight="54"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  RowDetailsVisibilityMode="Collapsed"
                  MouseDoubleClick="DgProductos_MouseDoubleClick">

                            <DataGrid.RowDetailsTemplate>

                                <DataTemplate>

                                    <Border Margin="42,0,12,12"
                Padding="16"
                CornerRadius="10"
                Background="{StaticResource ColorPanelClaro}"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="1">

                                        <StackPanel>

                                            <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">

                                                <TextBlock Text="Variantes de"
                               FontSize="13"
                               Foreground="{StaticResource ColorTextoSecundario}"/>

                                                <TextBlock Text="{Binding Nombre}"
                               Margin="5,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorCyanClaro}"/>

                                            </StackPanel>

                                            <DataGrid ItemsSource="{Binding Variantes}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          RowHeight="44"
          MinHeight="100"
          MaxHeight="250"
          Background="Transparent"
          BorderThickness="0"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="{StaticResource ColorBorde}"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto">

                                                <DataGrid.Columns>

                                                    <!-- DESCRIPCIÓN DE LA VARIANTE -->

                                                    <DataGridTemplateColumn Header="Descripción"
                                Width="180"
                                MinWidth="150">

                                                        <DataGridTemplateColumn.CellTemplate>

                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding VarianteDescripcion}"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource ColorTexto}"/>

                                                            </DataTemplate>

                                                        </DataGridTemplateColumn.CellTemplate>

                                                    </DataGridTemplateColumn>

                                                    <!-- CÓDIGO DE BARRAS -->

                                                    <DataGridTemplateColumn Header="Código de barras"
                                Width="170"
                                MinWidth="150">

                                                        <DataGridTemplateColumn.CellTemplate>

                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding CodigoBarras}"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{StaticResource ColorCyanClaro}"/>

                                                            </DataTemplate>

                                                        </DataGridTemplateColumn.CellTemplate>

                                                    </DataGridTemplateColumn>

                                                    <!-- PRECIO UNITARIO -->

                                                    <DataGridTemplateColumn Header="Precio U."
                                Width="110">

                                                        <DataGridTemplateColumn.CellTemplate>

                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding PrecioUnidad,
                                             StringFormat={}{0:N2}}"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource ColorTextoClaro}"/>

                                                            </DataTemplate>

                                                        </DataGridTemplateColumn.CellTemplate>

                                                    </DataGridTemplateColumn>

                                                    <!-- PRECIO MAYOR -->

                                                    <DataGridTemplateColumn Header="Precio M."
                                Width="110">

                                                        <DataGridTemplateColumn.CellTemplate>

                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding PrecioMayor,
                                             StringFormat={}{0:N2}}"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource ColorTextoClaro}"/>

                                                            </DataTemplate>

                                                        </DataGridTemplateColumn.CellTemplate>

                                                    </DataGridTemplateColumn>

                                                    <!-- STOCK EN ALMACÉN -->

                                                    <DataGridTemplateColumn Header="Almacén"
                                Width="100">

                                                        <DataGridTemplateColumn.CellTemplate>

                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding StockAlmacen}"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ColorTextoClaro}"/>

                                                            </DataTemplate>

                                                        </DataGridTemplateColumn.CellTemplate>

                                                    </DataGridTemplateColumn>

                                                    <!-- STOCK EN TIENDA -->

                                                    <DataGridTemplateColumn Header="Tienda"
                                Width="90">

                                                        <DataGridTemplateColumn.CellTemplate>

                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding StockTienda}"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ColorTextoClaro}"/>

                                                            </DataTemplate>

                                                        </DataGridTemplateColumn.CellTemplate>

                                                    </DataGridTemplateColumn>

                                                </DataGrid.Columns>

                                            </DataGrid>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </DataGrid.RowDetailsTemplate>

                            <DataGrid.Columns>

                                <!-- VER DETALLE -->

                                <DataGridTemplateColumn Header=""
                                        Width="42">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="›"
        Width="30"
        Height="30"
        Padding="0"
        FontSize="18"
        Tag="{Binding}"
        ToolTip="Mostrar variantes"
        Click="BtnDesplegarVariantes_Click">

                                                <Button.Style>

                                                    <Style TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">

                                                        <Setter Property="Visibility"
                    Value="Visible"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding TieneVariantes}"
                             Value="False">

                                                                <Setter Property="Visibility"
                            Value="Collapsed"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Button.Style>

                                            </Button>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- PRODUCTO -->

                                <DataGridTemplateColumn Header="Producto"
                                        Width="*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Nombre}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                                <TextBlock Text="{Binding Descripcion}"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- CATEGORÍA -->

                                <DataGridTextColumn Header="Categoría"
                                    Width="145"
                                    Binding="{Binding NombreCategoria}"/>

                                <!-- PRECIO UNITARIO -->

                                <DataGridTextColumn Header="Precio unidad"
                                    Width="110"
                                    Binding="{Binding PrecioUnidadTexto}"/>

                                <!-- PRECIO MAYOR -->

                                <DataGridTextColumn Header="Precio mayor"
                                    Width="110"
                                    Binding="{Binding PrecioMayorTexto}"/>

                                <!-- STOCK -->

                                <DataGridTextColumn Header="Stock"
                                    Width="80"
                                    Binding="{Binding StockTotal}"/>

                                <!-- CÓDIGO -->

                                <DataGridTextColumn Header="Código de barras"
                                    Width="145"
                                    Binding="{Binding CodigoBarrasTexto}"/>

                                <!-- ACCIONES -->

                                <DataGridTemplateColumn Header="Acciones"
                        Width="185">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                                <!-- VER DETALLE -->

                                                <Button Content="👁"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Margin="0,0,5,0"
                        Foreground="{StaticResource ColorCyan}"
                        Tag="{Binding}"
                        ToolTip="Ver detalle del producto"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnVerProducto_Click"/>

                                                <!-- EDITAR -->

                                                <Button Content="✎"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Margin="0,0,5,0"
                        Foreground="{StaticResource ColorAmarillo}"
                        Tag="{Binding}"
                        ToolTip="Editar producto"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnEditarProducto_Click"/>

                                                <!-- ELIMINAR -->

                                                <Button Content="🗑"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Foreground="{StaticResource ColorRojo}"
                        Tag="{Binding}"
                        ToolTip="Eliminar producto"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnEliminarProducto_Click"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>