                        <ColumnDefinition Width="14"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- FORMULARIO -->

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            VerticalAlignment="Top">

                        <StackPanel>

                            <TextBlock Text="Registrar operación"
                                       Style="{StaticResource TituloSeccionStyle}"/>

                            <TextBlock Text="Busca un producto disponible en tienda."
                                       Foreground="{StaticResource TextoSecundarioBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,18"/>


                            <!-- BUSCAR PRODUCTO -->

                            <TextBlock Text="Producto o código de barras"
                                       Style="{StaticResource EtiquetaStyle}"/>

                            <TextBox x:Name="TxtBuscarProducto"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     TextChanged="TxtBuscarProducto_TextChanged"
                                     KeyDown="TxtBuscarProducto_KeyDown"/>


                            <!-- RESULTADOS -->

                            <Border x:Name="BrdResultadosProductos"
        Visibility="Collapsed"
        Background="#101B31"
        BorderBrush="#22D3EE"
        BorderThickness="1"
        CornerRadius="10"
        MaxHeight="250"
        Margin="0,5,0,0">

                                <ListBox x:Name="LstResultadosProductos"
             BorderThickness="0"
             Background="Transparent"
             Foreground="#F8FAFC"
             SelectionChanged="LstResultadosProductos_SelectionChanged">

                                    <ListBox.ItemContainerStyle>

                                        <Style TargetType="ListBoxItem">

                                            <Setter Property="Padding"
                        Value="0"/>

                                            <Setter Property="Margin"
                        Value="4,3"/>

                                            <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>

                                            <Setter Property="Background"
                        Value="Transparent"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="ListBoxItem">

                                                        <Border x:Name="ResultadoBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="11">

                                                            <ContentPresenter/>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="IsMouseOver"
                                         Value="True">

                                                                <Setter TargetName="ResultadoBorder"
                                            Property="Background"
                                            Value="#172A46"/>

                                                            </Trigger>

                                                            <Trigger Property="IsSelected"
                                         Value="True">

                                                                <Setter TargetName="ResultadoBorder"
                                            Property="Background"
                                            Value="#164E63"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="44"/>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>

                                                <Border Width="36"
                            Height="36"
                            CornerRadius="9"
                            Background="#123A52"
                            VerticalAlignment="Center">

                                                    <TextBlock Text="▣"
                                   Foreground="#67E8F9"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                                                </Border>

                                                <StackPanel Grid.Column="1"
                                Margin="11,0">

                                                    <TextBlock Text="{Binding NombreCompleto}"
                                   Foreground="#F8FAFC"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                                                    <TextBlock Foreground="#94A3B8"
                                   FontSize="11"
                                   Margin="0,4,0,0">

                            <Run Text="{Binding Categoria}"/>

                            <Run Text="  ·  "/>

                            <Run Text="{Binding CodigoBarra}"/>

                                                    </TextBlock>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right">

                                                    <TextBlock Text="{Binding PrecioUnidadTexto}"
                                   Foreground="#67E8F9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                                                    <TextBlock Text="{Binding StockTiendaTexto}"
                                   Foreground="#4ADE80"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right"/>

                                                </StackPanel>

                                            </Grid>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Border>


                            <!-- PRODUCTO SELECCIONADO -->

                            <Border x:Name="BrdProductoSeleccionado"
        Visibility="Collapsed"
        BorderBrush="#22D3EE"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16"
        Margin="0,13,0,0">

                                <Border.Background>

                                    <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,1">

                                        <GradientStop Color="#102A43"
                          Offset="0"/>

                                        <GradientStop Color="#0C3542"
                          Offset="1"/>

                                    </LinearGradientBrush>

                                </Border.Background>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="52"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Width="44"
                Height="44"
                CornerRadius="12"
                Background="#164E63"
                BorderBrush="#22D3EE"
                BorderThickness="1"
                VerticalAlignment="Top">

                                        <TextBlock Text="▣"
                       Foreground="#67E8F9"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                    Margin="11,0,12,0">

                                        <TextBlock Text="{Binding NombreCompleto}"
                       Foreground="#F8FAFC"
                       FontSize="15"
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>

                                        <TextBlock Foreground="#94A3B8"
                       FontSize="11"
                       Margin="0,5,0,0">

                <Run Text="{Binding Categoria}"/>

                <Run Text="  ·  "/>

                <Run Text="{Binding CodigoBarra}"/>

                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,0">

                                            <Border Background="#123524"
                        CornerRadius="7"
                        Padding="8,4"
                        Margin="0,0,7,0">

                                                <TextBlock Text="{Binding PrecioUnidadTexto}"
                               Foreground="#86EFAC"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                                            </Border>

                                            <Border Background="#302A18"
                        CornerRadius="7"
                        Padding="8,4">

                                                <TextBlock Text="{Binding PrecioMayorTexto}"
                               Foreground="#FCD34D"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                                            </Border>

                                        </StackPanel>

                                    </StackPanel>

                                    <Border Grid.Column="2"
                Background="#123524"
                CornerRadius="10"
                Padding="11,8"
                VerticalAlignment="Center">

                                        <StackPanel>

                                            <TextBlock Text="DISPONIBLE"
                           Foreground="#BBF7D0"
                           FontSize="9"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                                            <TextBlock Text="{Binding StockTienda}"
                           Foreground="#4ADE80"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                                            <TextBlock Text="unidades"
                           Foreground="#86EFAC"
                           FontSize="9"
                           HorizontalAlignment="Center"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- OPCIONES DEL PRODUCTO -->

                            <StackPanel x:Name="PnlOpcionesProducto"
                                        Visibility="Collapsed">


                                <!-- CLIENTE -->

                                <TextBlock Text="Cliente o tienda"
                                           Style="{StaticResource EtiquetaStyle}"
                                           Margin="0,17,0,7"/>

                                <TextBox x:Name="TxtClienteTienda"
                                         Style="{StaticResource InputTextBoxStyle}"/>


                                <!-- CANTIDAD -->

                                <TextBlock Text="Cantidad"
                                           Style="{StaticResource EtiquetaStyle}"
                                           Margin="0,17,0,7"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="44"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="44"/>

                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="−"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BtnRestarCantidad_Click"
                                            FontSize="20"
                                            Padding="0"/>

                                    <TextBox x:Name="TxtCantidad"
                                             Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="1"
                                             Foreground="#F8FAFC"
                                             FontSize="15"
                                             FontWeight="SemiBold"
                                             TextAlignment="Center"
                                             Margin="8,0"
                                             TextChanged="TxtCantidad_TextChanged"/>    

                                    <Button Grid.Column="2"
                                            Content="+"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BtnSumarCantidad_Click"
                                            FontSize="18"
                                            Padding="0"/>

                                </Grid>


                                <!-- TIPO DE PRECIO -->

                                <TextBlock Text="Tipo de precio"
                                           Style="{StaticResource EtiquetaStyle}"
                                           Margin="0,17,0,7"/>

                                <ComboBox x:Name="CboTipoPrecio"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectionChanged="CboTipoPrecio_SelectionChanged">

                                    <ComboBoxItem Content="Precio por unidad"
                                                  Tag="UNIDAD"/>

                                    <ComboBoxItem Content="Precio por mayor"
                                                  Tag="MAYOR"/>

                                    <ComboBoxItem Content="Precio especial"
                                                  Tag="ESPECIAL"/>

                                </ComboBox>


                                <!-- PRECIO -->

                                <TextBlock Text="Precio utilizado"
                                           Style="{StaticResource EtiquetaStyle}"
                                           Margin="0,17,0,7"/>

                                <TextBox x:Name="TxtPrecio"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         TextChanged="TxtPrecio_TextChanged"/>


                                <!-- TIPO DE OPERACIÓN -->

                                <TextBlock Text="Tipo de operación"
                                           Style="{StaticResource EtiquetaStyle}"
                                           Margin="0,17,0,7"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="10"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <RadioButton x:Name="RbPrestamo"
             Grid.Column="0"
             Content="Préstamo"
             GroupName="TipoOperacion"
             IsChecked="True"
             Checked="RbTipoOperacion_Checked"
             Style="{StaticResource OperationRadioStyle}"
             Foreground="#4ADE80"
             BorderBrush="#166534"
             Background="#102A21"/>

                                    <RadioButton x:Name="RbCredito"
             Grid.Column="2"
             Content="Crédito"
             GroupName="TipoOperacion"
             Checked="RbTipoOperacion_Checked"
             Style="{StaticResource OperationRadioStyle}"
             Foreground="#FB7185"
             BorderBrush="#7F1D1D"
             Background="#301A20"/>

                                </Grid>


                                <!-- FECHA DE PAGO -->

                                <StackPanel x:Name="PnlFechaPago"
                                            Visibility="Collapsed">

                                    <TextBlock Text="Fecha esperada de pago"
                                               Style="{StaticResource EtiquetaStyle}"
                                               Margin="0,17,0,7"/>

                                    <DatePicker x:Name="DpFechaPago"
                                                 Style="{StaticResource InputDatePickerStyle}"
                                                SelectedDateFormat="Short"/>

                                </StackPanel>


                                <!-- OBSERVACIÓN -->

                                <TextBlock Text="Observación"
                                           Style="{StaticResource EtiquetaStyle}"
                                           Margin="0,17,0,7"/>

                                <TextBox x:Name="TxtObservacion"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Height="72"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"/>


                                <!-- TOTAL -->

                                <TextBlock Text="Total de la operación"
                                           Style="{StaticResource EtiquetaStyle}"
                                           Margin="0,17,0,7"/>

                                <TextBox x:Name="TxtTotal"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="True"
                                             Text="S/ 0.00"
                                             Background="#112E27"
                                             Foreground="#4ADE80"
                                             BorderBrush="#166534"
                                             FontSize="18"
                                             FontWeight="Bold"
                                             VerticalContentAlignment="Center"
                                             TextAlignment="Center"/>   


                                <!-- GUARDAR -->

                                <Button x:Name="BtnGuardarOperacion"
                                        Content="Guardar registro"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,18,0,0"
                                        Click="BtnGuardarOperacion_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>


                    <!-- LISTADOS -->

                    <StackPanel Grid.Column="2">


                        <!-- PRÉSTAMOS -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,20">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Productos prestados"
                                                   Style="{StaticResource TituloSeccionStyle}"/>

                                        <TextBlock Text="Últimos préstamos registrados."
                                                   Foreground="{StaticResource TextoSecundarioBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Ver todos"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36"
                                            Click="BtnVerTodosPrestamos_Click"/>

                                </Grid>

                                <Grid Grid.Row="1"
      Margin="0,16,0,0">

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>

                                    <!-- ENCABEZADOS -->

                                    <Border Background="#13203A"
            CornerRadius="9"
            Padding="14,11">

                                        <Grid >

                                            <Grid.ColumnDefinitions>

                                                   <ColumnDefinition Width="3.4*"/>
                                                   <ColumnDefinition Width="70"/>
                                                   <ColumnDefinition Width="95"/>
                                                   <ColumnDefinition Width="115"/>
                                                   <ColumnDefinition Width="115"/>
                                                   <ColumnDefinition Width="175"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                       Text="PRODUCTO"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                         Margin="8,0,12,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                       Text="CANT."
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"
                        TextAlignment="Center"
                        Margin="4,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                       Text="TOTAL"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                       Text="FECHA"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="4"
                       Text="ESTADO"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="5"
                       Text="ACCIONES"
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"
                        TextAlignment="Center"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  MaxHeight="340">

                                        <ItemsControl x:Name="DgPrestamos">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Margin="0,7,0,0"
                             MinHeight="74"
                             Padding="14,12"
                            BorderBrush="#24344F"
                            BorderThickness="1"
                            CornerRadius="10">

                                                        <Border.Style>

                                                            <Style TargetType="Border">

                                                                <Setter Property="Background"
                                        Value="#101B31"/>

                                                                <Style.Triggers>

                                                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                                                        <Setter Property="Background"
                                                Value="#142540"/>

                                                                        <Setter Property="BorderBrush"
                                                Value="#22D3EE"/>

                                                                    </Trigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Border.Style>

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                   <ColumnDefinition Width="3.4*"/>
                                                                   <ColumnDefinition Width="70"/>
                                                                   <ColumnDefinition Width="95"/>
                                                                   <ColumnDefinition Width="115"/>
                                                                   <ColumnDefinition Width="115"/>
                                                                   <ColumnDefinition Width="175"/>

                                                            </Grid.ColumnDefinitions>

                                                              <Grid Grid.Column="0" Margin="8,0,12,0" VerticalAlignment="Center">
                                                                  <Grid.RowDefinitions>
                                                                      <RowDefinition Height="Auto"/>
                                                                      <RowDefinition Height="Auto"/>
                                                                  </Grid.RowDefinitions>
                                                                  <TextBlock Grid.Row="0" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                      <Run Text="{Binding NombreProducto}"/>
                                                                      <Run Text=" - " Foreground="#94A3B8"/>
                                                                      <Run Text="{Binding Variante}"/>
                                                                  </TextBlock>
                                                                  <TextBlock Grid.Row="1" Foreground="#94A3B8" FontSize="9" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                                      <Run Text="Código: "/>
                                                                      <Run Text="{Binding CodigoBarra}"/>
                                                                      <Run Text=" · "/>
                                                                      <Run Text="{Binding NumeroOperacion}"/>
                                                                  </TextBlock>
                                                              </Grid>

                                                             <Border Grid.Column="1"
                                     Width="44"
                                     Height="34"
                                    Background="#172A46"
                                    CornerRadius="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding Cantidad}"
                                           Foreground="#67E8F9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                                            </Border>

                                                             <TextBlock Grid.Column="2"
                                       Text="{Binding TotalTexto}"
                                        Foreground="#4ADE80"
                                        FontWeight="Bold"
                                        Margin="6,0"
                                        VerticalAlignment="Center"/>

                                                              <StackPanel Grid.Column="3" Margin="8,0" VerticalAlignment="Center">
                                                                 <TextBlock Text="{Binding FechaRegistro, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#CBD5E1" FontSize="10"/>
                                                                 <TextBlock Text="{Binding FechaRegistro, StringFormat={}{0:HH:mm}}" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                                                             </StackPanel>

                                                             <Border Grid.Column="4"
                                    CornerRadius="9"
                                    Padding="8,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                                                <Border.Style>

                                                                    <Style TargetType="Border">

                                                                        <Setter Property="Background"
                                                Value="#123524"/>

                                                                        <Style.Triggers>

                                                                            <DataTrigger Binding="{Binding EstaPendiente}"
                                                               Value="True">

                                                                                <Setter Property="Background"
                                                        Value="#3A2A10"/>

                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{Binding VenceHoy}" Value="True">
                                                                                <Setter Property="Background" Value="#3A2A10"/>
                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{Binding EstaVencido}" Value="True">
                                                                                <Setter Property="Background" Value="#3A1D22"/>
                                                                            </DataTrigger>

                                                                        </Style.Triggers>

                                                                    </Style>

                                                                </Border.Style>

                                                                <TextBlock Text="{Binding EstadoMostrar}"
                                           FontSize="10"
                                           FontWeight="Bold">

                                                                    <TextBlock.Style>

                                                                        <Style TargetType="TextBlock">

                                                                            <Setter Property="Foreground"
                                                    Value="#86EFAC"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger Binding="{Binding EstaPendiente}"
                                                              Value="True">

                                                                                    <Setter Property="Foreground"
                                                             Value="#FCD34D"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding VenceHoy}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#67E8F9"/>
                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding EstaVencido}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                                </DataTrigger>

                                                                            </Style.Triggers>

                                                                        </Style>

                                                                    </TextBlock.Style>

                                                                </TextBlock>

                                                            </Border>

                                                              <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                                                <Button Tag="{Binding}"
                                          ToolTip="Ver"
                                         Style="{StaticResource IconActionButtonStyle}"
                                         Background="#334155"
                                         Foreground="#E2E8F0"
                                         Click="BtnVerOperacion_Click">
                                                                    <Viewbox Width="16" Height="16"><Path Data="M1,8 C3.2,4.3 5.5,2.5 8,2.5 C10.5,2.5 12.8,4.3 15,8 C12.8,11.7 10.5,13.5 8,13.5 C5.5,13.5 3.2,11.7 1,8 Z M8,5.5 A2.5,2.5 0 1 1 8,10.5 A2.5,2.5 0 1 1 8,5.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                                                                </Button>

                                                                <Button
                                         Tag="{Binding}"
                                         IsEnabled="{Binding PuedeDevolver}"
                                          ToolTip="Devolver"
                                         Style="{StaticResource IconActionButtonStyle}"
                                          Background="#22C55E"
                                          Foreground="#052E16"
                                         Click="BtnDevolverPrestamo_Click">
                                                                    <Viewbox Width="16" Height="16"><Path Data="M8,2 L3,7 L6.5,7 L6.5,11 C6.5,12.1 7.4,13 8.5,13 L13,13 L13,10.5 L9,10.5 L9,7 L13,7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                                                                </Button>

                                                                <Button
                                         Tag="{Binding}"
                                         IsEnabled="{Binding PuedePasarACobranza}"
                                          ToolTip="A cobranza"
                                         Style="{StaticResource IconActionButtonStyle}"
                                          Background="#F59E0B"
                                          Foreground="#451A03"
                                         Click="BtnPasarACobranza_Click">
                                                                    <Viewbox Width="17" Height="17"><Path Data="M3,2 L14,2 L14,14 L3,14 Z M8.5,4.3 C6.7,4.3 5.6,5.2 5.6,6.5 C5.6,9 11.3,7.2 11.3,9.5 C11.3,10.2 10.7,10.7 9.5,10.7 C8.4,10.7 7.4,10.3 6.6,9.7 L5.8,11 C6.6,11.7 7.6,12.1 8.7,12.2 L8.7,13 L9.8,13 L9.8,12.1 C11.4,11.9 12.4,10.9 12.4,9.5 C12.4,6.9 6.7,8.7 6.7,6.4 C6.7,5.8 7.3,5.5 8.3,5.5 C9.2,5.5 10.1,5.8 10.9,6.3 L11.6,5 C11,4.6 10.4,4.3 9.8,4.2 L9.8,3.4 L8.7,3.4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                                                                </Button>

                                                             </StackPanel>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                     </ScrollViewer>

                                    <TextBlock Grid.Row="1"
                                               Text="No hay préstamos registrados."
                                               Foreground="#94A3B8"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=DgPrestamos}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </Grid>

                            </Grid>

                        </Border>


                        <!-- COBRANZAS -->

                        <Border Style="{StaticResource CardStyle}">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Cobranzas pendientes"
                                                   Style="{StaticResource TituloSeccionStyle}"/>

                                        <TextBlock Text="Créditos registrados y pagos pendientes."
                                                   Foreground="{StaticResource TextoSecundarioBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Ver todos"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36"
                                            Click="BtnVerTodosCreditos_Click"/>

                                </Grid>

                                <Grid Grid.Row="1"
      Margin="0,16,0,0">

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>

                                    <Border Background="#13203A"
            CornerRadius="9"
            Padding="14,11">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                   <ColumnDefinition Width="2.8*"/>
                                                   <ColumnDefinition Width="1.4*"/>
                                                   <ColumnDefinition Width="70"/>
                                                   <ColumnDefinition Width="95"/>
                                                   <ColumnDefinition Width="120"/>
                                                   <ColumnDefinition Width="115"/>
                                                   <ColumnDefinition Width="175"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                        Text="PRODUCTO"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                         Margin="8,0,12,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                        Text="CLIENTE / TIENDA"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="8,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                       Text="CANT."
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="4,0"
                        TextAlignment="Center"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                       Text="DEUDA"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="4"
                       Text="VENCIMIENTO"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="5"
                       Text="ESTADO"
                       Foreground="#94A3B8"
                       FontSize="10"
                        FontWeight="Bold"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="6"
                       Text="ACCIONES"
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"
                        TextAlignment="Center"
                        Margin="6,0"
                        VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                    <ScrollViewer Grid.Row="1"
                   HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  MaxHeight="340">

                                        <ItemsControl x:Name="DgCreditos">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Margin="0,7,0,0"
                             MinHeight="74"
                             Padding="14,12"
                            BorderBrush="#24344F"
                            BorderThickness="1"
                            CornerRadius="10">

                                                        <Border.Style>

                                                            <Style TargetType="Border">

                                                                <Setter Property="Background"
                                        Value="#101B31"/>

                                                                <Style.Triggers>

                                                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                                                        <Setter Property="Background"
                                                Value="#142540"/>

                                                                        <Setter Property="BorderBrush"
                                                Value="#FB7185"/>

                                                                    </Trigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Border.Style>

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                   <ColumnDefinition Width="2.8*"/>
                                                                   <ColumnDefinition Width="1.4*"/>
                                                                   <ColumnDefinition Width="70"/>
                                                                   <ColumnDefinition Width="95"/>
                                                                   <ColumnDefinition Width="120"/>
                                                                   <ColumnDefinition Width="115"/>
                                                                   <ColumnDefinition Width="175"/>

                                                            </Grid.ColumnDefinitions>

                                                              <Grid Grid.Column="0" Margin="8,0,12,0" VerticalAlignment="Center">
                                                                  <Grid.RowDefinitions>
                                                                      <RowDefinition Height="Auto"/>
                                                                      <RowDefinition Height="Auto"/>
                                                                  </Grid.RowDefinitions>
                                                                  <TextBlock Grid.Row="0" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                      <Run Text="{Binding NombreProducto}"/>
                                                                      <Run Text=" - " Foreground="#94A3B8"/>
                                                                      <Run Text="{Binding Variante}"/>
                                                                  </TextBlock>
                                                                  <TextBlock Grid.Row="1" Foreground="#94A3B8" FontSize="9" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                                      <Run Text="Código: "/>
                                                                      <Run Text="{Binding CodigoBarra}"/>
                                                                      <Run Text=" · "/>
                                                                      <Run Text="{Binding NumeroOperacion}"/>
                                                                  </TextBlock>
                                                              </Grid>

                                                              <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                                 <TextBlock Text="{Binding ClienteTienda}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                              </StackPanel>

                                                            <Border Grid.Column="2"
                                     Width="44"
                                     Height="34"
                                    Background="#172A46"
                                    CornerRadius="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding Cantidad}"
                                           Foreground="#67E8F9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                                            </Border>

                                                            <TextBlock Grid.Column="3"
                                       Text="{Binding TotalTexto}"
                                        Foreground="#FB7185"
                                        FontWeight="Bold"
                                        Margin="6,0"
                                        VerticalAlignment="Center"/>

                                                              <StackPanel Grid.Column="4" Margin="8,0" VerticalAlignment="Center">
                                                                 <TextBlock Text="{Binding FechaPagoEsperada, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#FCD34D" FontSize="10" FontWeight="SemiBold"/>
                                                                 <TextBlock Text="{Binding FechaPagoEsperada, StringFormat={}{0:ddd}}" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                                                             </StackPanel>

                                                            <Border Grid.Column="5"
                                    CornerRadius="9"
                                    Padding="8,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                                                <Border.Style>

                                                                    <Style TargetType="Border">

                                                                        <Setter Property="Background"
                                                Value="#123524"/>

                                                                        <Style.Triggers>

                                                                            <DataTrigger Binding="{Binding EstaPendiente}"
                                                         Value="True">

                                                                                <Setter Property="Background"
                                                        Value="#3A2A10"/>

                                                                            </DataTrigger>

                                                                        </Style.Triggers>

                                                                    </Style>

                                                                </Border.Style>

                                                                <TextBlock Text="{Binding EstadoMostrar}"
                                           FontSize="10"
                                           FontWeight="Bold">

                                                                    <TextBlock.Style>

                                                                        <Style TargetType="TextBlock">

                                                                            <Setter Property="Foreground"
                                                    Value="#86EFAC"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger Binding="{Binding EstaPendiente}"
                                                             Value="True">

                                                                                    <Setter Property="Foreground"
                                                            Value="#FCD34D"/>

                                                                                </DataTrigger>

                                                                            </Style.Triggers>

                                                                        </Style>

                                                                    </TextBlock.Style>

                                                                </TextBlock>

                                                            </Border>

                                                             <StackPanel Grid.Column="6"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                                                <Button
                                         Tag="{Binding}"
                                          ToolTip="Ver"
                                         Style="{StaticResource IconActionButtonStyle}"
                                          Background="#334155"
                                          Foreground="#F8FAFC"
                                         Click="BtnVerOperacion_Click">
                                                                    <Viewbox Width="16" Height="16"><Path Data="M1,8 C3.2,4.3 5.5,2.5 8,2.5 C10.5,2.5 12.8,4.3 15,8 C12.8,11.7 10.5,13.5 8,13.5 C5.5,13.5 3.2,11.7 1,8 Z M8,5.5 A2.5,2.5 0 1 1 8,10.5 A2.5,2.5 0 1 1 8,5.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                                                                </Button>

                                                                <Button
                                         Tag="{Binding}"
                                         IsEnabled="{Binding PuedePagar}"
                                          ToolTip="Pagar"
                                         Style="{StaticResource IconActionButtonStyle}"
                                          Background="#22C55E"
                                          Foreground="#052E16"
                                         Click="BtnPagarCredito_Click">
                                                                    <Viewbox Width="17" Height="17"><Path Data="M2,4 L15,4 L15,13 L2,13 Z M4,6 L8,6 L8,7 L4,7 Z M4,9 L10,9 L10,10 L4,10 Z M12,8 A1.5,1.5 0 1 1 12,11 A1.5,1.5 0 1 1 12,8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                                                                </Button>

                                                                <Button
                                         Tag="{Binding}"
                                         IsEnabled="{Binding PuedePasarAPrestamo}"
                                          ToolTip="A préstamo"
                                         Style="{StaticResource IconActionButtonStyle}"
                                          Background="#3B82F6"
                                          Foreground="#FFFFFF"
                                          Click="BtnPasarAPrestamo_Click">
                                                                    <Viewbox Width="17" Height="17"><Path Data="M3,5 L10,5 L8,3 L9.5,1.5 L14,6 L9.5,10.5 L8,9 L10,7 L3,7 Z M14,11 L7,11 L9,13 L7.5,14.5 L3,10 L7.5,5.5 L9,7 L7,9 L14,9 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                                                                </Button>

                                                                <Button
                                          Tag="{Binding}"
                                          ToolTip="Ver boleta"
                                          Background="#0E7490"
                                          Foreground="#FFFFFF"
                                          Click="BtnVerBoleta_Click">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IdPagoCredito}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding VenceHoy}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#FCD34D"/>
                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding EstaVencido}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Viewbox Width="16" Height="16"><Path Data="M4,1 L12,1 L14,3 L14,15 L2,15 L2,3 Z M5,6 L11,6 L11,7 L5,7 Z M5,9 L11,9 L11,10 L5,10 Z M5,12 L9,12 L9,13 L5,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox>
                                                                </Button>

                                                             </StackPanel>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                     </ScrollViewer>

                                    <TextBlock Grid.Row="1"
                                               Text="No hay cobranzas pendientes."
                                               Foreground="#94A3B8"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=DgCreditos}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </Grid>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
