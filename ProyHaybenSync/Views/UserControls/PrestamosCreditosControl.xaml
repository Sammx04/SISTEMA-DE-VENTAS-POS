                                           Foreground="{StaticResource TextoSecundarioBrush}"
                                           FontSize="12"/>

                            </StackPanel>

                            <Border Grid.Row="2"
                                    Background="#3A1D22"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,14,0,0">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Deuda total:"
                                               Foreground="#FECACA"
                                               FontSize="12"/>

                                    <TextBlock x:Name="TxtDeudaTotal"
                                               Text="S/ 0.00"
                                               Foreground="#FB7185"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="5,0,0,0"/>

                                </StackPanel>

                            </Border>

