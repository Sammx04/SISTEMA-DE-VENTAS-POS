<UserControl x:Class="ProySistemaVentas.Views.UserControls.PrestamosCreditosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1500"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- COLORES PRINCIPALES -->

        <SolidColorBrush x:Key="FondoPrincipalBrush"
                         Color="#0B1120"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="PanelClaroBrush"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="PanelSecundarioBrush"
                         Color="#101B31"/>

        <SolidColorBrush x:Key="BordeBrush"
                         Color="#24344F"/>

        <SolidColorBrush x:Key="CianBrush"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="CianClaroBrush"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="VerdeBrush"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="AmarilloBrush"
                         Color="#F59E0B"/>

        <SolidColorBrush x:Key="RojoBrush"
                         Color="#EF4444"/>

        <SolidColorBrush x:Key="TextoPrincipalBrush"
                         Color="#F8FAFC"/>

        <SolidColorBrush x:Key="TextoSecundarioBrush"
                         Color="#94A3B8"/>


        <!-- TARJETAS -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BordeBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

        </Style>


        <!-- TEXTOS -->

        <Style x:Key="TituloSeccionStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextoPrincipalBrush}"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <Style x:Key="EtiquetaStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- TEXTBOX -->

        <Style x:Key="InputTextBoxStyle"
       TargetType="TextBox">

            <Setter Property="Height"
            Value="44"/>

            <Setter Property="Padding"
            Value="13,0"/>

            <Setter Property="Background"
            Value="#101B31"/>

            <Setter Property="Foreground"
            Value="#F8FAFC"/>

            <Setter Property="CaretBrush"
            Value="#22D3EE"/>

            <Setter Property="BorderBrush"
            Value="#2B3E60"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="SelectionBrush"
            Value="#0E7490"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                             Value="True">

                                <Setter TargetName="InputBorder"
                                Property="BorderBrush"
                                Value="#22D3EE"/>

                                <Setter TargetName="InputBorder"
                                Property="BorderThickness"
                                Value="1.5"/>

                                <Setter TargetName="InputBorder"
                                Property="Background"
                                Value="#13203A"/>

                            </Trigger>

                            <Trigger Property="IsReadOnly"
                             Value="True">

                                <Setter TargetName="InputBorder"
                                Property="Background"
                                Value="#0D1729"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter TargetName="InputBorder"
                                Property="Opacity"
                                Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- DATEPICKER OSCURO -->
        <Style x:Key="InputDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#101B31"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2B3E60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Background" Value="#101B31"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Style.Resources>
        </Style>


        <!-- COMBOBOX OSCURO -->

        <Style x:Key="InputComboBoxStyle"
       TargetType="ComboBox">

            <Setter Property="Height"
            Value="44"/>

            <Setter Property="Background"
            Value="#101B31"/>

            <Setter Property="Foreground"
            Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
            Value="#2B3E60"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="Padding"
            Value="13,0,42,0"/>

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="HorizontalContentAlignment"
            Value="Left"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="MaxDropDownHeight"
            Value="240"/>

            <Setter Property="SnapsToDevicePixels"
            Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- FONDO DEL COMBO -->

                            <Border x:Name="ComboBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"/>


                            <!-- ELEMENTO SELECCIONADO -->

                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>


                            <!-- BOTÓN Y FLECHA -->

                            <ToggleButton x:Name="ToggleButton"
                                  Focusable="False"
                                  ClickMode="Press"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border Background="Transparent">

                                            <Grid>

                                                <Border Width="35"
                                                HorizontalAlignment="Right"
                                                Background="#13203A"
                                                CornerRadius="0,9,9,0"/>

                                                <Path x:Name="Arrow"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#67E8F9"
                                              Width="10"
                                              Height="6"
                                              Stretch="Fill"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsChecked"
                                             Value="True">

                                                <Setter TargetName="Arrow"
                                                Property="RenderTransform">

                                                    <Setter.Value>

                                                        <RotateTransform Angle="180"
                                                                 CenterX="5"
                                                                 CenterY="3"/>

                                                    </Setter.Value>

                                                </Setter>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>


                            <!-- LISTA DESPLEGABLE -->

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ToggleButton}"
                           AllowsTransparency="True"
                           Focusable="False"
                           StaysOpen="False"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           PopupAnimation="Fade">

                                <Border MinWidth="{Binding ActualWidth,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="#0D1729"
                                BorderBrush="#22D3EE"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4"
                                Margin="0,4,0,0">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ComboBorder"
                                Property="BorderBrush"
                                Value="#22D3EE"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                             Value="True">

                                <Setter TargetName="ComboBorder"
                                Property="BorderBrush"
                                Value="#22D3EE"/>

                                <Setter TargetName="ComboBorder"
                                Property="BorderThickness"
                                Value="1.5"/>

                                <Setter TargetName="ComboBorder"
                                Property="Background"
                                Value="#13203A"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter Property="Opacity"
                                Value="0.50"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ELEMENTOS DEL COMBOBOX -->

        <Style TargetType="ComboBoxItem">

            <Setter Property="Foreground"
            Value="#E2E8F0"/>

            <Setter Property="Background"
            Value="Transparent"/>

            <Setter Property="Padding"
            Value="12,9"/>

            <Setter Property="HorizontalContentAlignment"
            Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="7"
                        Padding="{TemplateBinding Padding}"
                        Margin="2">

                            <ContentPresenter VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#172A46"/>

                                <Setter Property="Foreground"
                                Value="#67E8F9"/>

                            </Trigger>

                            <Trigger Property="IsHighlighted"
                             Value="True">

                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#164E63"/>

                                <Setter Property="Foreground"
                                Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                             Value="True">

                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#0E7490"/>

                                <Setter Property="Foreground"
                                Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter Property="Opacity"
                                Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- TIPO DE OPERACIÓN -->

        <Style x:Key="OperationRadioStyle"
       TargetType="RadioButton">

            <Setter Property="Height"
            Value="44"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="FontSize"
            Value="12"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="OperationBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,7">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="21"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Border x:Name="RadioCircle"
                                Width="15"
                                Height="15"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="1"
                                VerticalAlignment="Center">

                                    <Ellipse x:Name="RadioDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{TemplateBinding Foreground}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>

                                </Border>

                                <ContentPresenter Grid.Column="1"
                                          Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="OperationBorder"
                                Property="Opacity"
                                Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                             Value="True">

                                <Setter TargetName="RadioDot"
                                Property="Visibility"
                                Value="Visible"/>

                                <Setter TargetName="OperationBorder"
                                Property="BorderThickness"
                                Value="1.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN PRINCIPAL -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="{StaticResource CianBrush}"/>

            <Setter Property="Foreground"
                    Value="#082F49"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="16,8"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BotonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BotonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BotonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BotonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- BOTÓN SECUNDARIO -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
                    Value="{StaticResource PanelClaroBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource CianClaroBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BordeBrush}"/>

        </Style>


        <!-- BOTONES DE ACCIONES -->

        <Style x:Key="ActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="MinWidth"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Padding"
                    Value="9,3"/>

            <Setter Property="Margin"
                    Value="2"/>

        </Style>

        <Style x:Key="IconActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
        </Style>


        <!-- DATAGRID -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextoPrincipalBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="{StaticResource BordeBrush}"/>

            <Setter Property="RowBackground"
                    Value="{StaticResource PanelBrush}"/>

            <Setter Property="AlternatingRowBackground"
                    Value="{StaticResource PanelSecundarioBrush}"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="RowHeight"
                    Value="58"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="{StaticResource PanelClaroBrush}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BordeBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="10,5"/>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8,4"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Foreground"
                    Value="{StaticResource TextoPrincipalBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#172A46"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#164E63"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid Background="{StaticResource FondoPrincipalBrush}"
      ClipToBounds="True">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  CanContentScroll="False">

            <Grid Margin="18"
              HorizontalAlignment="Stretch">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ENCABEZADO -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Width="58"
                            Height="58"
                            CornerRadius="16"
                            Background="#164E63"
                            BorderBrush="{StaticResource CianBrush}"
                            BorderThickness="1">

                        <TextBlock Text="↔"
                                   Foreground="{StaticResource CianClaroBrush}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="16,2,0,0">

                        <TextBlock Text="Préstamos y Créditos"
                                   Foreground="{StaticResource TextoPrincipalBrush}"
                                   FontSize="29"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Administra productos prestados, cobranzas pendientes, devoluciones y pagos."
                                   Foreground="{StaticResource TextoSecundarioBrush}"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- RESUMEN -->

                <Grid Grid.Row="1"
                      Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1.25*"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- TRABAJADOR -->

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Margin="0,0,14,0">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <TextBlock Text="Trabajador responsable"
                                       Style="{StaticResource TituloSeccionStyle}"/>

                            <TextBlock Grid.Row="1"
                                       Text="Debe seleccionarse antes de registrar, devolver, cobrar o convertir una operación."
                                       Foreground="{StaticResource TextoSecundarioBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,6,0,14"/>

                            <Grid Grid.Row="2">

                                <ComboBox x:Name="CboTrabajador"
              Style="{StaticResource InputComboBoxStyle}"
              Padding="51,0,42,0"
              DisplayMemberPath="NombreMostrar"
              SelectedValuePath="IdUsuario"
              SelectedIndex="-1"/>

                                <!-- ICONO DEL TRABAJADOR -->

                                <Border Width="32"
            Height="32"
            CornerRadius="8"
            Background="#164E63"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="6,0,0,0"
            IsHitTestVisible="False">

                                    <Viewbox Width="16"
                 Height="16"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

                                        <Path Data="M 12,2
      C 9.79,2 8,3.79 8,6
      C 8,8.21 9.79,10 12,10
      C 14.21,10 16,8.21 16,6
      C 16,3.79 14.21,2 12,2
      Z
      M 12,12
      C 8.67,12 2,13.67 2,17
      L 2,20
      L 22,20
      L 22,17
      C 22,13.67 15.33,12 12,12
      Z"
                  Fill="#67E8F9" Cursor=""/>

                                    </Viewbox>

                                </Border>


                                <!-- TEXTO CUANDO NO HAY TRABAJADOR -->

                                <TextBlock Text="Seleccione un trabajador"
               Foreground="#64748B"
               FontSize="13"
               Margin="51,0,42,0"
               VerticalAlignment="Center"
               IsHitTestVisible="False">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                        Value="Collapsed"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding SelectedItem,
                                                   ElementName=CboTrabajador}"
                                 Value="{x:Null}">

                                                    <Setter Property="Visibility"
                                Value="Visible"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- RESUMEN PRÉSTAMOS -->

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Margin="0,0,14,0"
                            BorderBrush="#14532D">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <TextBlock Text="Préstamos"
                                       Foreground="#86EFAC"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <StackPanel Grid.Row="1"
                                        Margin="0,15,0,0">

                                <TextBlock x:Name="TxtPrestamosPendientes"
                                           Text="0"
                                           Foreground="#4ADE80"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                                <TextBlock Text="pendientes de devolución"
                                           Foreground="{StaticResource TextoSecundarioBrush}"
                                           FontSize="12"/>

                            </StackPanel>

                            <Border Grid.Row="2"
                                    Background="#123524"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,14,0,0">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Stock prestado:"
                                               Foreground="#BBF7D0"
                                               FontSize="12"/>

                                    <TextBlock x:Name="TxtStockPrestado"
                                               Text="0 unidades"
                                               Foreground="#4ADE80"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="5,0,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- RESUMEN CRÉDITOS -->

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            BorderBrush="#7C2D12">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <TextBlock Text="Cobranzas"
                                       Foreground="#FCA5A5"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <StackPanel Grid.Row="1"
                                        Margin="0,15,0,0">

                                <TextBlock x:Name="TxtCreditosPendientes"
                                           Text="0"
                                           Foreground="#FB7185"
                                           FontSize="30"
                                           FontWeight="Bold"/>

