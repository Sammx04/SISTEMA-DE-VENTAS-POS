<UserControl x:Class="ProySistemaVentas.Views.UserControls.VentaPOSControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="VentaPOSControl_Loaded"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ================================================= -->
        <!-- COLORES -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="ColorFondo"
                         Color="#0B1120"/>

        <SolidColorBrush x:Key="ColorPanel"
                         Color="#0D1526"/>

        <SolidColorBrush x:Key="ColorPanelClaro"
                         Color="#13203A"/>

        <SolidColorBrush x:Key="ColorPanelSecundario"
                         Color="#101B31"/>

        <SolidColorBrush x:Key="ColorBorde"
                         Color="#24344F"/>

        <SolidColorBrush x:Key="ColorTexto"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="ColorCyan"
                         Color="#22D3EE"/>

        <SolidColorBrush x:Key="ColorCyanClaro"
                         Color="#67E8F9"/>

        <SolidColorBrush x:Key="ColorVerde"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="ColorAmarillo"
                         Color="#F59E0B"/>

        <SolidColorBrush x:Key="ColorRojo"
                         Color="#EF4444"/>

        <!-- ================================================= -->
        <!-- TEXTBOX -->
        <!-- ================================================= -->

        <Style x:Key="TextBoxVenta"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="SelectionBrush"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="BordeCampo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="BordeCampo"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter TargetName="BordeCampo"
                                        Property="Background"
                                        Value="#132039"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeCampo"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- COMBOBOX -->
        <!-- ================================================= -->

        <Style x:Key="ComboBoxVenta"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>

        <Style TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Style.Triggers>

                <Trigger Property="IsHighlighted"
                         Value="True">

                    <Setter Property="Background"
                            Value="#CFFAFE"/>

                    <Setter Property="Foreground"
                            Value="#0F172A"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#A5F3FC"/>

                    <Setter Property="Foreground"
                            Value="#0F172A"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN BÁSICO -->
        <!-- ================================================= -->

        <Style x:Key="BotonBase"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="Foreground"
                    Value="#CBD5E1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.45"/>

                                <Setter Property="Cursor"
                                        Value="Arrow"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN CONFIRMAR -->
        <!-- ================================================= -->

        <Style x:Key="BotonConfirmar"
               TargetType="Button"
               BasedOn="{StaticResource BotonBase}">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorCyan}"/>

            <Setter Property="Foreground"
                    Value="#07111D"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN ELIMINAR -->
        <!-- ================================================= -->

        <Style x:Key="BotonEliminar"
               TargetType="Button">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="#301A24"/>

            <Setter Property="Foreground"
                    Value="#FCA5A5"/>

            <Setter Property="BorderBrush"
                    Value="#7F1D1D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="Background"
                                        Value="#7F1D1D"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTONES DE CANTIDAD -->
        <!-- ================================================= -->

        <Style x:Key="BotonCantidad"
               TargetType="Button">

            <Setter Property="Width"
                    Value="32"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelClaro}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeBoton"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="BordeBoton"
                                        Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN NOMBRE DEL PRODUCTO -->
        <!-- ================================================= -->

        <Style x:Key="BotonNombreProducto"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="Transparent">

                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Foreground"
                                        Value="{StaticResource ColorCyanClaro}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- BOTONES DE TIPO DE PRECIO -->
        <!-- ================================================= -->

        <Style x:Key="BotonPrecioUnidadCarrito"
               TargetType="Button"
               BasedOn="{StaticResource BotonBase}">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding EsPrecioUnidad, Mode=OneWay}"
                             Value="True">

                    <Setter Property="Background"
                            Value="#123047"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource ColorCyanClaro}"/>

                    <Setter Property="BorderBrush"
                            Value="{StaticResource ColorCyan}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="BotonPrecioMayorCarrito"
               TargetType="Button"
               BasedOn="{StaticResource BotonBase}">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding EsPrecioMayor, Mode=OneWay}"
                             Value="True">

                    <Setter Property="Background"
                            Value="#123047"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource ColorCyanClaro}"/>

                    <Setter Property="BorderBrush"
                            Value="{StaticResource ColorCyan}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN MÉTODO DE PAGO -->
        <!-- ================================================= -->

        <Style x:Key="BotonMetodoPago"
               TargetType="Button"
               BasedOn="{StaticResource BotonBase}">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="15,0"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN PRODUCTO RESULTADO -->
        <!-- ================================================= -->

        <Style x:Key="BotonProductoResultado"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource ColorPanelSecundario}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="13"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BordeResultado"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BordeResultado"
                                        Property="Background"
                                        Value="#152641"/>

                                <Setter TargetName="BordeResultado"
                                        Property="BorderBrush"
                                        Value="{StaticResource ColorCyan}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BordeResultado"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- ===================================================== -->
    <!-- CONTENIDO GENERAL -->
    <!-- ===================================================== -->

    <Grid Background="{StaticResource ColorFondo}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <Grid MinWidth="1180"
                  Margin="24">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="18"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- ENCABEZADO -->
                <!-- ================================================= -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="52"
                            Height="52"
                            Background="#123047"
                            BorderBrush="{StaticResource ColorCyan}"
                            BorderThickness="1"
                            CornerRadius="14">

                        <TextBlock Text="▣"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="25"
                                   Foreground="{StaticResource ColorCyan}"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Punto de Venta"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorTexto}"/>

                        <TextBlock Text="Busque productos, agregue al carrito y registre la venta"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                    </StackPanel>

                </Grid>

                <!-- ================================================= -->
                <!-- TARJETAS DE RESUMEN -->
                <!-- ================================================= -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="14"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="14"/>

                        <ColumnDefinition Width="1.35*"/>

                    </Grid.ColumnDefinitions>

                    <!-- PRODUCTOS DEL CARRITO -->

                    <Border Grid.Column="0"
                            Height="112"
                            Padding="20"
                            Background="{StaticResource ColorPanel}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="13">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="PRODUCTOS EN CARRITO"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <TextBlock x:Name="TxtCantidadCarrito"
                                           Text="0"
                                           Margin="0,13,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                <TextBlock x:Name="TxtTiposProducto"
                                           Text="0 tipos de producto"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Top"
                                    Background="#172A44"
                                    CornerRadius="10">

                                <TextBlock Text="▣"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           Foreground="{StaticResource ColorCyan}"/>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- TOTAL ACTUAL -->

                    <Border Grid.Column="2"
                            Height="112"
                            Padding="20"
                            Background="{StaticResource ColorPanel}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="13">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="TOTAL ACTUAL"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <TextBlock x:Name="TxtTotalActual"
                                           Text="S/ 0.00"
                                           Margin="0,17,0,0"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorCyanClaro}"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Top"
                                    Background="#102C2A"
                                    CornerRadius="10">

                                <TextBlock Text="S/"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#86EFAC"/>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- TRABAJADOR -->

                    <Border Grid.Column="4"
                            Height="112"
                            Padding="18"
                            Background="{StaticResource ColorPanel}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="13">

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="TRABAJADOR QUE REALIZA LA VENTA"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <TextBlock Grid.Column="1"
                                           Text="OBLIGATORIO"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#FCA5A5"/>

                            </Grid>

                            <ComboBox x:Name="CboTrabajador"
                                      Margin="0,12,0,0"
                                      Style="{StaticResource ComboBoxVenta}"
                                      DisplayMemberPath="NombreMostrar"
                                      SelectedValuePath="IdUsuario"
                                      SelectionChanged="CboTrabajador_SelectionChanged"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ================================================= -->
                <!-- TRES PANELES -->
                <!-- ================================================= -->

                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="320"/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition Width="340"/>

                    </Grid.ColumnDefinitions>

                    <!-- ================================================= -->
                    <!-- BÚSQUEDA -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
                            Padding="18"
                            Background="{StaticResource ColorPanel}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="14">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">

                                <TextBlock Text="⌕  Búsqueda de productos"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                <TextBlock Text="Nombre, variante o código de barras"
                                           Margin="0,5,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </StackPanel>

                            <!-- BUSCADOR -->

                            <Grid Grid.Row="1"
                                  Margin="0,18,0,0">

                                <TextBox x:Name="TxtBuscarProducto"
                                         Style="{StaticResource TextBoxVenta}"
                                         Padding="39,0,12,0"
                                         TextChanged="TxtBuscarProducto_TextChanged"
                                         PreviewKeyDown="TxtBuscarProducto_PreviewKeyDown"/>

                                <TextBlock Text="⌕"
                                           Margin="14,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="{StaticResource ColorTextoSecundario}"
                                           IsHitTestVisible="False"/>

                                <TextBlock x:Name="TxtPlaceholderBusqueda"
                                           Text="Buscar o escanear producto..."
                                           Margin="39,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           IsHitTestVisible="False"/>

                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="▣  Escanee el código y presione Enter"
                                       Margin="2,10,0,14"
                                       FontSize="10"
                                       Foreground="{StaticResource ColorTextoSecundario}"/>

                            <!-- RESULTADOS -->

                            <Border x:Name="PanelResultadosBusqueda"
                                    Grid.Row="3"
                                    MaxHeight="315"
                                    Margin="0,0,0,15"
                                    Padding="9"
                                    Background="#0A1220"
                                    BorderBrush="{StaticResource ColorBorde}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed">

                                <Grid>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                        <ItemsControl x:Name="ItemsResultadosBusqueda">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Button Tag="{Binding}"
                                                            Style="{StaticResource BotonProductoResultado}"
                                                            Click="BtnAgregarProductoBusqueda_Click">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0"
                                                                        Margin="0,0,10,0">

                                                                <TextBlock Text="{Binding NombreCompleto, Mode=OneWay}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource ColorTexto}"/>

                                                                <TextBlock Text="{Binding Categoria, Mode=OneWay}"
                                                                           Margin="0,4,0,0"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                                                <TextBlock Margin="0,4,0,0"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource ColorCyanClaro}">

                                                                    <Run Text="Código: "/>

                                                                    <Run Text="{Binding CodigoBarra, Mode=OneWay}"/>

                                                                </TextBlock>

                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1"
                                                                        HorizontalAlignment="Right">

                                                                <TextBlock Text="{Binding PrecioUnidadTexto, Mode=OneWay}"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ColorCyanClaro}"/>

                                                                <TextBlock Margin="0,4,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="9"
                                                                           Foreground="#86EFAC">

                                                                    <Run Text="Mayor: "/>

                                                                    <Run Text="{Binding PrecioMayorTexto, Mode=OneWay}"/>

                                                                </TextBlock>

                                                                <TextBlock Text="{Binding StockTexto, Mode=OneWay}"
                                                                           Margin="0,4,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                                            </StackPanel>

                                                        </Grid>

                                                    </Button>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                    <StackPanel x:Name="PanelSinResultadosBusqueda"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">

                                        <TextBlock Text="⌕"
                                                   HorizontalAlignment="Center"
                                                   FontSize="25"
                                                   Foreground="#475569"/>

                                        <TextBlock Text="No se encontraron productos"
                                                   Margin="0,8,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- FRECUENTES -->

                            <Grid Grid.Row="4">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Productos frecuentes"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ColorTexto}"/>

                                    <Border Grid.Column="1"
                                            Padding="8,3"
                                            Background="#123047"
                                            CornerRadius="10">

                                        <TextBlock Text="TOP 5"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ColorCyanClaro}"/>

                                    </Border>

                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,12,0,0">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                        <ItemsControl x:Name="ItemsProductosFrecuentes">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Button Tag="{Binding}"
                                                            Style="{StaticResource BotonProductoResultado}"
                                                            Click="BtnProductoFrecuente_Click">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>

                                                                <TextBlock Text="{Binding NombreCompleto, Mode=OneWay}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource ColorTexto}"/>

                                                                <TextBlock Text="{Binding PrecioUnidadTexto, Mode=OneWay}"
                                                                           Margin="0,5,0,0"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource ColorCyanClaro}"/>

                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1"
                                                                        VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding VecesVendido, Mode=OneWay}"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="#86EFAC"/>

                                                                <TextBlock Text="vendidos"
                                                                           Margin="0,2,0,0"
                                                                           FontSize="8"
                                                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                                            </StackPanel>

                                                        </Grid>

                                                    </Button>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                    <StackPanel x:Name="PanelSinFrecuentes"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">

                                        <TextBlock Text="☆"
                                                   HorizontalAlignment="Center"
                                                   FontSize="26"
                                                   Foreground="#475569"/>

                                        <TextBlock Text="Todavía no hay ventas frecuentes hoy"
                                                   Margin="0,8,0,0"
                                                   FontSize="10"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- ================================================= -->
                    <!-- CARRITO -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource ColorPanel}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="14">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,15">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="▣  Carrito de compra"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ColorTexto}"/>

                                    <TextBlock Text="Presione el nombre para aplicar descuento"
                                               Margin="0,5,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource ColorTextoSecundario}"/>

                                </StackPanel>

                                <TextBlock x:Name="TxtCantidadProductosCarrito"
                                           Grid.Column="1"
                                           Text="0 productos"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                            </Grid>

                            <Grid Grid.Row="1">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">

                                    <ItemsControl x:Name="ItemsCarrito">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Border Margin="0,0,0,12"
                                                        Padding="15"
                                                        Background="{StaticResource ColorPanelSecundario}"
                                                        BorderBrush="{StaticResource ColorBorde}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">

                                                    <StackPanel>

                                                        <!-- ENCABEZADO PRODUCTO -->

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    Tag="{Binding}"
                                                                    Style="{StaticResource BotonNombreProducto}"
                                                                    Click="BtnEditarItem_Click">

                                                                <StackPanel>

                                                                    <TextBlock Text="{Binding NombreProducto, Mode=OneWay}"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                                                    Path=Foreground}"/>

                                                                    <TextBlock Text="{Binding DetalleProducto, Mode=OneWay}"
                                                                               Margin="0,4,0,0"
                                                                               FontSize="9"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{StaticResource ColorTextoSecundario}"/>

                                                                    <TextBlock Margin="0,4,0,0"
                                                                               FontSize="9"
                                                                               Foreground="{StaticResource ColorCyanClaro}">

                                                                        <Run Text="Código: "/>

                                                                        <Run Text="{Binding CodigoBarra, Mode=OneWay}"/>

                                                                    </TextBlock>

                                                                </StackPanel>

                                                            </Button>

                                                            <Button Grid.Column="1"
                                                                    Tag="{Binding}"
                                                                    Content="🗑"
                                                                    VerticalAlignment="Top"
                                                                    Style="{StaticResource BotonEliminar}"
                                                                    Click="BtnEliminarItem_Click"/>

                                                        </Grid>

                                                        <!-- TIPO DE PRECIO -->

                                                        <Grid Margin="0,13,0,0">

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="8"/>

                                                                <ColumnDefinition Width="*"/>

                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    Tag="{Binding}"
                                                                    Style="{StaticResource BotonPrecioUnidadCarrito}"
                                                                    Click="BtnUsarPrecioUnidad_Click">

                                                                <StackPanel>

                                                                    <TextBlock Text="Precio por unidad"
                                                                               HorizontalAlignment="Center"/>

                                                                    <TextBlock Text="{Binding PrecioUnidadTexto, Mode=OneWay}"
                                                                               Margin="0,2,0,0"
                                                                               HorizontalAlignment="Center"
                                                                               FontSize="9"
                                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                                                    Path=Foreground}"/>

                                                                </StackPanel>

                                                            </Button>

                                                            <Button Grid.Column="2"
                                                                    Tag="{Binding}"
                                                                    IsEnabled="{Binding TienePrecioMayor, Mode=OneWay}"
                                                                    Style="{StaticResource BotonPrecioMayorCarrito}"
                                                                    Click="BtnUsarPrecioMayor_Click">

                                                                <StackPanel>

                                                                    <TextBlock Text="Precio por mayor"
                                                                               HorizontalAlignment="Center"/>

                                                                    <TextBlock Text="{Binding PrecioMayorTexto, Mode=OneWay}"
                                                                               Margin="0,2,0,0"
                                                                               HorizontalAlignment="Center"
                                                                               FontSize="9"
                                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                                                    Path=Foreground}"/>

                                                                </StackPanel>

                                                            </Button>

                                                        </Grid>

                                                        <!-- CANTIDAD Y TOTAL -->

                                                        <Grid Margin="0,14,0,0">

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="Auto"/>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">

                                                                <Button Tag="{Binding}"
                                                                        Content="−"
                                                                        Style="{StaticResource BotonCantidad}"
                                                                        Click="BtnRestarCantidad_Click"/>

                                                                <TextBlock Text="{Binding Cantidad, Mode=OneWay}"
                                                                           Width="46"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           TextAlignment="Center"
                                                                           Foreground="{StaticResource ColorTexto}"/>

                                                                <Button Tag="{Binding}"
                                                                        Content="+"
                                                                        IsEnabled="{Binding PuedeAumentarCantidad, Mode=OneWay}"
                                                                        Style="{StaticResource BotonCantidad}"
                                                                        Click="BtnSumarCantidad_Click"/>

                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        HorizontalAlignment="Right">

                                                                <TextBlock Text="{Binding ResumenPrecioCantidad, Mode=OneWay}"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                                                <TextBlock Text="{Binding TotalLineaTexto, Mode=OneWay}"
                                                                           Margin="0,4,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ColorCyanClaro}"/>

                                                            </StackPanel>

                                                        </Grid>

                                                        <!-- DESCUENTO -->

                                                        <Border Margin="0,11,0,0"
                                                                Padding="10,7"
                                                                Background="#302810"
                                                                BorderBrush="#765910"
                                                                BorderThickness="1"
                                                                CornerRadius="8">

                                                            <TextBlock FontSize="9"
                                                                       Foreground="#FDE68A">

                                                                <Run Text="Descuento aplicado: "/>

                                                                <Run Text="{Binding DescuentoTexto, Mode=OneWay}"
                                                                     FontWeight="Bold"/>

                                                            </TextBlock>

                                                        </Border>

                                                    </StackPanel>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </ScrollViewer>

                                <StackPanel x:Name="PanelCarritoVacio"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Border Width="70"
                                            Height="70"
                                            Background="#111C30"
                                            CornerRadius="35">

                                        <TextBlock Text="▣"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="31"
                                                   Foreground="#475569"/>

                                    </Border>

                                    <TextBlock Text="No hay productos en el carrito"
                                               Margin="0,14,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ColorTextoSecundario}"/>

                                    <TextBlock Text="Busque o escanee un producto para comenzar"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="9"
                                               Foreground="#64748B"/>

                                </StackPanel>

                            </Grid>

                            <!-- TOTALES DEL CARRITO -->

                            <Border Grid.Row="2"
                                    Margin="0,15,0,0"
                                    Padding="15"
                                    Background="#0A1220"
                                    BorderBrush="{StaticResource ColorBorde}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="10">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Subtotal"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ColorTextoSecundario}"/>

                                        <TextBlock x:Name="TxtSubtotal"
                                                   Grid.Column="1"
                                                   Text="S/ 0.00"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ColorTexto}"/>

                                    </Grid>

                                    <Grid x:Name="FilaRecargoTarjetaCarrito"
                                          Grid.Row="1"
                                          Margin="0,8,0,0"
                                          Visibility="Collapsed">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Recargo tarjeta 5%"
                                                   FontSize="11"
                                                   Foreground="#FBBF24"/>

                                        <TextBlock x:Name="TxtRecargoTarjeta"
                                                   Grid.Column="1"
                                                   Text="S/ 0.00"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FBBF24"/>

                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,12,0,0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="TOTAL A PAGAR"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ColorTexto}"/>

                                        <TextBlock x:Name="TxtTotalCarrito"
                                                   Grid.Column="1"
                                                   Text="S/ 0.00"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ColorCyanClaro}"/>

                                    </Grid>

                                </Grid>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- ================================================= -->
                    <!-- PAGO -->
                    <!-- ================================================= -->

                    <Border Grid.Column="4"
                            Padding="18"
                            Background="{StaticResource ColorPanel}"
                            BorderBrush="{StaticResource ColorBorde}"
                            BorderThickness="1"
                            CornerRadius="14">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <StackPanel>

                                <TextBlock Text="▣  Panel de pago"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                <TextBlock Text="Complete los datos para registrar la venta"
                                           Margin="0,5,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <!-- TOTAL -->

                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        Background="#10263A"
                                        BorderBrush="#1D5369"
                                        BorderThickness="1"
                                        CornerRadius="11">

                                    <StackPanel>

                                        <TextBlock Text="TOTAL A PAGAR"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ColorCyan}"/>

                                        <TextBlock x:Name="TxtTotalPago"
                                                   Text="S/ 0.00"
                                                   Margin="0,8,0,0"
                                                   FontSize="27"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ColorCyanClaro}"/>

                                    </StackPanel>

                                </Border>

                                <!-- CLIENTE -->

                                <TextBlock Text="Datos del cliente"
                                           Margin="0,19,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                <TextBlock Text="Opcional para incluir DNI o RUC en la boleta"
                                           Margin="0,4,0,8"
                                           FontSize="9"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="105"/>

                                        <ColumnDefinition Width="9"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="CboTipoDocumento"
                                              Grid.Column="0"
                                              Style="{StaticResource ComboBoxVenta}"
                                              SelectedIndex="0"
                                              SelectionChanged="CboTipoDocumento_SelectionChanged">

                                        <ComboBoxItem Content="Otros"
                                                      Tag="OTROS"/>

                                        <ComboBoxItem Content="DNI"
                                                      Tag="DNI"/>

                                        <ComboBoxItem Content="RUC"
                                                      Tag="RUC"/>

                                    </ComboBox>

                                    <TextBox x:Name="TxtNumeroDocumento"
                                             Grid.Column="2"
                                             Style="{StaticResource TextBoxVenta}"
                                             MaxLength="20"
                                             IsEnabled="False"
                                             PreviewTextInput="TxtNumeroDocumento_PreviewTextInput"/>

                                </Grid>

                                <TextBlock x:Name="TxtAyudaDocumento"
                                           Text="No se registrará documento del cliente."
                                           Margin="2,7,0,0"
                                           FontSize="9"
                                           Foreground="{StaticResource ColorTextoSecundario}"/>

                                <!-- MÉTODO DE PAGO -->

                                <TextBlock Text="Método de pago"
                                           Margin="0,20,0,9"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorTexto}"/>

                                <Button x:Name="BtnPagoEfectivo"
                                        Content="💵  Efectivo"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource BotonMetodoPago}"
                                        Click="BtnPagoEfectivo_Click"/>

                                <Button x:Name="BtnPagoYapePlin"
                                        Content="▣  Yape / Plin"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource BotonMetodoPago}"
                                        Click="BtnPagoYapePlin_Click"/>

                                <Button x:Name="BtnPagoTarjeta"
                                        Content="▤  Tarjeta + 5%"
                                        Style="{StaticResource BotonMetodoPago}"
                                        Click="BtnPagoTarjeta_Click"/>

                                <Border Margin="0,11,0,0"
                                        Padding="11"
                                        Background="#302810"
                                        BorderBrush="#765910"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <TextBlock Text="El pago con tarjeta añade un recargo del 5% al subtotal de la venta."
                                               FontSize="9"
                                               LineHeight="14"
                                               TextWrapping="Wrap"
                                               Foreground="#FDE68A"/>

                                </Border>

                                <!-- BOTONES -->

                                <Button x:Name="BtnConfirmarVenta"
                                        Content="✓  Confirmar venta"
                                        Margin="0,23,0,0"
                                        Style="{StaticResource BotonConfirmar}"
                                        Click="BtnConfirmarVenta_Click"/>

                                <Button x:Name="BtnCancelarVenta"
                                        Content="✕  Cancelar venta"
                                        Margin="0,9,0,0"
                                        Style="{StaticResource BotonBase}"
                                        Click="BtnCancelarVenta_Click"/>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </Grid>

        </ScrollViewer>

        <!-- ================================================= -->
        <!-- CARGANDO -->
        <!-- ================================================= -->

        <Border x:Name="PanelCargando"
                Background="#CC0B1120"
                Visibility="Collapsed">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Border Width="58"
                        Height="58"
                        Background="#123047"
                        BorderBrush="{StaticResource ColorCyan}"
                        BorderThickness="1"
                        CornerRadius="29">

                    <TextBlock Text="…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorCyanClaro}"/>

                </Border>

                <TextBlock x:Name="TxtMensajeCargando"
                           Text="Procesando venta..."
                           Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>