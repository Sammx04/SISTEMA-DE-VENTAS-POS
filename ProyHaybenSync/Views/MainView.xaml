<Window x:Class="ProySistemaVentas.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Ventas"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <StackPanel Background="#2C3E50">

            <TextBlock
                Text="SISTEMA POS"
                Foreground="White"
                FontSize="20"
                FontWeight="Bold"
                Margin="20"/>

            <Button Content="Productos"
                    Margin="10"
                    Height="40"/>

            <Button Content="Usuarios"
                    Margin="10"
                    Height="40"
                    Click="BtnUsuarios_Click"/>

            <Button Content="Ventas"
                    Margin="10"
                    Height="40"/>

            <Button Content="Caja"
                    Margin="10"
                    Height="40"/>

            <Button Content="Reportes"
                    Margin="10"
                    Height="40"/>

        </StackPanel>

        <!-- Área principal -->
        <Grid Grid.Column="1">

            <ContentControl x:Name="ContenidoPrincipal"/>

        </Grid>

    </Grid>

</Window>