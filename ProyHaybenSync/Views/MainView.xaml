<Window x:Class="ProySistemaVentas.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Ventas - HAYBEN"
        Height="720"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ===== PALETA DE COLORES ===== -->
        <SolidColorBrush x:Key="AccentCyan" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentCyanBright" Color="#67E8F9"/>
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedLight" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="HoverBg" Color="#13203A"/>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B1120" Offset="0"/>
            <GradientStop Color="#0D1526" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- ESTILO MENÚ -->
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,4,8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MenuGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="12,0,12,0">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Ellipse x:Name="Indicator" Width="6" Height="6" Fill="{StaticResource AccentCyan}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#22D3EE" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#13203A"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A2A47"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="0.5"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBright}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============= PANEL LATERAL ============= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" CornerRadius="0,20,20,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. LOGO -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,30,20,25">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource LogoGradient}">
                        <Path Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border.Effect>
                            <DropShadowEffect Color="#22D3EE" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="HAYBEN" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextWhite}"/>
                        <TextBlock Text="S T O R E   M A N A G E M E N T" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. MENÚ (Opciones) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Dashboard -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Dashboard" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Usuarios -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}" x:Name="BtnUsuarios" Click="BtnUsuarios_Click" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Usuarios" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- NUEVAS OPCIONES -->

                        <!-- Caja -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: point_of_sale (caja registradora) -->
                                <Path Data="M17 2H7a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zm0 4H7V4h10v2zm3 12H4a2 2 0 0 1-2-2V8h20v8a2 2 0 0 1-2 2zm-1-10H5v6h14v-6zm-7 8h-2v2h2v-2zm0-4h-2v2h2v-2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Caja" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Almacén / Productos -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: warehouse (almacén) -->
                                <Path Data="M22 21V7L12 3 2 7v14h5v-9h10v9h5zm-11-2H9v2h2v-2zm2-3h-2v2h2v-2zm2 3h-2v2h2v-2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Almacén / Productos" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Inventario / Tienda -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: store (tienda) -->
                                <Path Data="M21.9 8.89l-1.05-4.37c-.22-.9-1-1.53-1.91-1.53H4.06c-.91 0-1.69.63-1.91 1.53L1.1 8.89c-.24 1.02-.02 2.06.61 2.82.62.76 1.55 1.19 2.54 1.19.82 0 1.57-.32 2.13-.88.56.56 1.31.88 2.13.88s1.57-.32 2.13-.88c.56.56 1.31.88 2.13.88s1.57-.32 2.13-.88c.56.56 1.31.88 2.13.88 1 0 1.92-.43 2.54-1.19.63-.76.85-1.8.61-2.82zM12 12.5c-1.38 0-2.5-1.12-2.5-2.5H4.5l.84-3.5h13.32l.84 3.5H14.5c0 1.38-1.12 2.5-2.5 2.5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Inventario / Tienda" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Ventas -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: bar_chart (gráfico de ventas) -->
                                <Path Data="M9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4zm2 2H5V5h14v14zm0-16H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Ventas" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Préstamos y Créditos -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: account_balance (banco) -->
                                <Path Data="M4 10h3v7H4v-7zm6 0h3v7h-3v-7zm-8 12h20v-2H2v2zm16-12h3v7h-3v-7zm-4.5-7l-7 4h14l-7-4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Préstamos y Créditos" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Incidencias -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: warning (triángulo de alerta) -->
                                <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Incidencias" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Auditorías / Historial -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: history (reloj con flecha) -->
                                <Path Data="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Auditorías / Historial" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Reportes -->
                        <RadioButton Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Icono: description (documento con líneas) -->
                                <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 15h8v2H8v-2zm0-4h8v2H8v-2zm0 8h5v-2H8v2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="Reportes" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. PERFIL (se eliminó la tarjeta de almacenamiento) -->
                <StackPanel Grid.Row="2" Margin="16,0,16,20">
                    <!-- Solo perfil -->
                    <Border Background="#13203A" CornerRadius="12" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource LogoGradient}" Margin="0,0,10,0">
                                <TextBlock Text="EA" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Erick A." Foreground="{StaticResource TextWhite}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Administrador" Foreground="{StaticResource TextMutedLight}" FontSize="10"/>
                            </StackPanel>
                            <Path Grid.Column="2" Data="M7 10l5 5 5-5z" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============= ÁREA PRINCIPAL ============= -->
        <Border Grid.Column="1" Background="Transparent" Margin="0,0,0,0">
            <Grid Margin="0,10,10,10">
                <ContentControl x:Name="ContenidoPrincipal"/>
            </Grid>
        </Border>
    </Grid>
</Window>