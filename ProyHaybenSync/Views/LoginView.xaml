<Window x:Class="ProySistemaVentas.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Sistema de Ventas"
        Height="600"
        Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Definición de colores -->
        <SolidColorBrush x:Key="ColorRightPanel" Color="#F0F8FF"/>
        <!-- Alice Blue -->
        <SolidColorBrush x:Key="ColorTextDark" Color="#232B2B"/>
        <!-- Charleston Green -->
        <SolidColorBrush x:Key="ColorInputBorder" Color="#40E0D0"/>
        <!-- Turquoise -->
        <SolidColorBrush x:Key="ColorPrimaryBtn" Color="#008080"/>
        <!-- Teal -->
        <SolidColorBrush x:Key="ColorAccentLink" Color="#15A3C7"/>
        <!-- Cyan Blue -->

        <!-- Estilos inputs -->
        <Style x:Key="LoginInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorInputBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextDark}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorInputBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextDark}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= PANEL IZQUIERDO (Totalmente corregido) ================= -->
        <!-- Agregué Background="#006D6F" para que si la imagen falla, sea oscuro y se vea el texto -->
        <Grid Grid.Column="0" Background="#006D6F">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- El fondo (Imagen + Capa oscura) debe estar dentro de un Grid con RowSpan=3 -->
            <Grid Grid.RowSpan="3">
                <!-- 1. IMAGEN DE FONDO (Con URL corregida) -->
                <!-- RECOMENDACIÓN: Si falla, descarga la imagen y cámbiala por Source="/Imagenes/fondo.jpg" -->
                <Image Source="https://img.magnific.com/vector-gratis/fondo-tecnologia-digital-alambre-malla-red_1017-27428.jpg?semt=ais_hybrid&amp;w=740&amp;q=80" 
                       Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect Radius="12"/>
                    </Image.Effect>
                </Image>

                <!-- 2. CAPA OSCURA (Asegura que el blanco del logo resalte) -->
                <Rectangle Fill="Black" Opacity="0.75" />
            </Grid>

            <!-- 3. CONTENIDO DE LA IZQUIERDA (Ubicados en las filas correctas) -->
            <!-- Fila 0: Menú -->
   

            <!-- Fila 1: Logo y Nombre (Ahora es visible) -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="HAYBEN" FontSize="36" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" FontStretch="Expanded"/>
                <TextBlock Text="SISTEMA DE VENTAS" FontSize="12" Foreground="#D0F0F0" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Fila 2: Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="f" Foreground="White" FontSize="20" Margin="0,0,15,0"/>
                <TextBlock Text="t" Foreground="White" FontSize="20" Margin="0,0,15,0"/>
                <TextBlock Text="ig" Foreground="White" FontSize="20"/>
            </StackPanel>
        </Grid>

        <!-- ================= PANEL DERECHO (Login) ================= -->
        <Grid Grid.Column="1" Background="{StaticResource ColorRightPanel}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

                <!-- Títulos -->
                <TextBlock Text="Login" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ColorTextDark}" Margin="0,0,0,5"/>
                <TextBlock Text="Bienvenido, por favor inicia sesión" FontSize="14" Foreground="#666666" Margin="0,0,0,30"/>

                <TextBlock Text="Usuario" FontWeight="SemiBold" Foreground="{StaticResource ColorTextDark}" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource LoginInputStyle}" Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Contraseña" FontWeight="SemiBold" Foreground="{StaticResource ColorTextDark}" Margin="0,20,0,5"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource LoginPasswordStyle}"/>

                <TextBlock Text="¿Olvidaste tu contraseña?" Foreground="{StaticResource ColorAccentLink}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,20" Cursor="Hand"/>

                <!-- Botón -->
                <Button Content="INGRESAR" 
                        Height="45"
                        Click="BtnIngresar_Click"
                        Background="{StaticResource ColorPrimaryBtn}"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#09D0EF"/>
                                    <Setter Property="Foreground" Value="{StaticResource ColorTextDark}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>



            </StackPanel>
        </Grid>

    </Grid>
</Window>