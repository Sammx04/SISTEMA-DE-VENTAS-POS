<Window x:Class="ProySistemaVentas.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - HAYBEN"
        Height="680"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- COLORES CORREGIDOS: Separamos Color de Brush para evitar errores XDG-0001 -->
        <Color x:Key="ColorAccentCyan">#00EAFF</Color>
        <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}"/>

        <!-- Colores del Lado Derecho (Login Oscuro) -->
        <SolidColorBrush x:Key="ColorRightPanelBG" Color="#0B0F19"/>
        <SolidColorBrush x:Key="ColorCardBG" Color="#141E33"/>
        <SolidColorBrush x:Key="ColorTextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorTextGray" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="ColorInputBorder" Color="#2D3B57"/>

        <!-- Estilos Inputs -->
        <Style x:Key="DarkInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextWhite}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushAccentCyan}"/>
        </Style>
        <Style x:Key="DarkPassStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextWhite}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushAccentCyan}"/>
        </Style>

        <!-- Estilo Botón Login -->
        <Style x:Key="CyanButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushAccentCyan}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <!-- CORREGIDO: Usamos Color en lugar del Brush -->
                                <DropShadowEffect Color="{StaticResource ColorAccentCyan}" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <!-- IZQUIERDA: Nueva Info HAYBEN -->
            <ColumnDefinition Width="60*"/>
            <!-- DERECHA: Login Oscuro -->
        </Grid.ColumnDefinitions>

        <!-- ================= PANEL IZQUIERDO (Rediseñado con Texto y Botones) ================= -->
        <Grid Grid.Column="0" Background="#0A101D">
            <!-- Fondo base oscuro en caso de que no cargue la imagen -->

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Menú -->
                <RowDefinition Height="*"/>
                <!-- Texto y Logo Central -->
                <RowDefinition Height="Auto"/>
                <!-- Botones Inferiores -->
            </Grid.RowDefinitions>

            <!-- Fondo (Ocupa todo el bloque) -->
            <Grid Grid.RowSpan="3">
                <!-- Si no carga la imagen de web, puedes reemplazarla por una local -->
                <Image Source="https://img.magnific.com/vector-gratis/fondo-tecnologia-digital-alambre-malla-red_1017-27428.jpg?semt=ais_hybrid&amp;w=740&amp;q=80" Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect Radius="8"/>
                    </Image.Effect>
                </Image>
                <Rectangle Fill="Black" Opacity="0.80" />
            </Grid>


            <!-- CONTENIDO CENTRAL (Logo, Texto y Subtítulo) -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Logo y Nombre HAYBEN -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="50" Height="50" CornerRadius="12" Background="{StaticResource BrushAccentCyan}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource ColorAccentCyan}" BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <!-- Icono pequeño dentro del recuadro -->
                        <TextBlock Text="⚙" FontSize="26" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="HAYBEN" FontSize="32" FontWeight="Black" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>

                <!-- Título Grande -->
                <TextBlock Text="Sistema de Gestión" FontSize="34" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Tecnológico" FontSize="34" FontWeight="ExtraBold" Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                <!-- Subtítulo -->
                <TextBlock Text="Control total de ventas, inventario y operaciones" FontSize="15" Foreground="#A0B0C0" HorizontalAlignment="Center"/>
                <TextBlock Text="para tu tienda de tecnología." FontSize="15" Foreground="#A0B0C0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- CONTENIDO INFERIOR (Los 3 Botones) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,463,0,96" Grid.RowSpan="2">

                <!-- Botón Ventas POS -->
                <Border Width="90" Height="85" Background="#141E33" BorderBrush="#2D3B57" BorderThickness="1" CornerRadius="12" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" Fill="{StaticResource BrushAccentCyan}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,0,5"/>
                        <TextBlock Text="Ventas POS" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Botón Inventario -->
                <Border Width="90" Height="85" Background="#141E33" BorderBrush="#2D3B57" BorderThickness="1" CornerRadius="12" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M12 2l-9 5v10l9 5 9-5V7L12 2zm-7 6.8l7 3.8 7-3.8v2.2l-7 3.9-7-3.9V8.8zm7 14.5l-7-3.9v-2.2l7 3.9 7-3.9v2.2l-7 3.9z" Fill="{StaticResource BrushAccentCyan}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,0,5"/>
                        <TextBlock Text="Inventario" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Botón Reportes -->
                <Border Width="90" Height="85" Background="#141E33" BorderBrush="#2D3B57" BorderThickness="1" CornerRadius="12" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M4 5v14h16V5H4zm2 2h12v10H6V7zm2 2h2v6H8V9zm4 0h2v4h-2V9zm4 0h2v8h-2V9z" Fill="{StaticResource BrushAccentCyan}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,0,5"/>
                        <TextBlock Text="Reportes" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ================= PANEL DERECHO (Login Oscuro, se mantiene igual) ================= -->
        <Grid Grid.Column="1" Background="{StaticResource ColorRightPanelBG}">
            <Border Background="{StaticResource ColorCardBG}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Iniciar sesión" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ColorTextWhite}" Margin="0,0,0,5"/>
                    <TextBlock Text="Accede a tu panel de administración" FontSize="14" Foreground="{StaticResource ColorTextGray}" Margin="0,0,0,25"/>

                    <TextBlock Text="CORREO ELECTRÓNICO" FontSize="12" Foreground="{StaticResource ColorTextGray}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="#111827" BorderBrush="{StaticResource ColorInputBorder}" BorderThickness="1" CornerRadius="8" Margin="0,-4,0,-11" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="0.496"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Path Grid.Column="0" Data="M2 4h20v16H2V4zm2 2v12h16V6H4zm2 2l6 5 6-5v2l-6 5-6-5V8z" Fill="{StaticResource ColorTextGray}" Width="20" Height="9" Stretch="Uniform" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                        <TextBox Grid.Column="1" Style="{StaticResource DarkInputStyle}" Margin="29,0,0,-5" Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Tag="usuario@hayben.com"/>
                    </Grid>

                    <TextBlock Text="CONTRASEÑA" FontSize="12" Foreground="{StaticResource ColorTextGray}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" Background="#111827" BorderBrush="{StaticResource ColorInputBorder}" BorderThickness="1" CornerRadius="8" Height="26" VerticalAlignment="Top"/>
                        <Path Grid.Column="0" Data="M12 2C9.243 2 7 4.243 7 7v3H6c-1.105 0-2 .895-2 2v8c0 1.105.895 2 2 2h12c1.105 0 2-.895 2-2v-8c0-1.105-.895-2-2-2h-1V7c0-2.757-2.243-5-5-5zm0 2c1.654 0 3 1.346 3 3v3H9V7c0-1.654 1.346-3 3-3zm0 10c1.105 0 2 .895 2 2s-.895 2-2 2-2-.895-2-2 .895-2 2-2z" Fill="{StaticResource ColorTextGray}" Width="18" Height="12" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="18,0,0,0"/>
                        <PasswordBox x:Name="txtPassword" Grid.Column="1" Style="{StaticResource DarkPassStyle}" Margin="43,0,3,0"/>
                        <Path Grid.Column="1" Data="M12 4.5C16.694 4.5 20.477 7.419 22.248 11C20.477 14.581 16.694 17.5 12 17.5C7.306 17.5 3.523 14.581 1.752 11C3.523 7.419 7.306 4.5 12 4.5ZM12 7C9.791 7 8 8.791 8 11C8 13.209 9.791 15 12 15C14.209 15 16 13.209 16 11C16 8.791 14.209 7 12 7Z" Fill="{StaticResource ColorTextGray}" Width="16" Height="20" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" Grid.ColumnSpan="2" Margin="316,8,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <Button Style="{StaticResource CyanButton}" Click="BtnIngresar_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Iniciar sesión" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>